From: Armada <noreply@armada.local>
Subject: [PATCH] mangoapp: pause while the Steam UI is focused

When the Steam UI has focus (GAMESCOPE_FOCUSED_APP_GFX 769) and
mangoapp_steam is off, mangoapp skips drawing the HUD but still renders
and swaps an empty full-screen overlay every frame, keeps the window
mapped as a gamescope overlay, and does an X round trip per gamescope
frame to read the focused app. On the AYN Odin 3 that is a third
scanout plane, ~8k cross-CPU wakeups/s between mangoapp and Xwayland,
and ~70 mA of idle battery draw in the Steam UI.

Take the existing hidden path (unmap, clear the overlay atom, pause the
GPU threads) while the Steam UI is focused, poll the focused app at
most 4x/s, and let the user opt back in to the overlay in the Steam UI
with mangoapp_steam or steam_ui=1 in /etc/armada/performance-overlay.conf
(re-read when it changes).
---
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -3,8 +3,12 @@
 // If you are new to Dear ImGui, read documentation from the docs/ folder + read the top of imgui.cpp.
 // Read online: https://github.com/ocornut/imgui/tree/master/docs
 
+#include <chrono>
+#include <algorithm>
+#include <fstream>
 #include <sys/ipc.h>
 #include <sys/msg.h>
+#include <sys/stat.h>
 
 #include "imgui.h"
 #include "imgui_impl_glfw.h"
@@ -42,6 +46,41 @@ static std::string deviceName;
 static notify_thread notifier;
 static int msgid;
 static bool mangoapp_paused = false;
+
+// Armada: let the user opt in to the overlay in the Steam UI (default off).
+#define ARMADA_OVERLAY_CONF "/etc/armada/performance-overlay.conf"
+
+static bool armada_steam_ui_enabled(){
+    static std::chrono::steady_clock::time_point last_check;
+    static struct timespec last_mtime = {};
+    static bool enabled = false;
+    auto now = std::chrono::steady_clock::now();
+    if (now - last_check < std::chrono::seconds(1))
+        return enabled;
+    last_check = now;
+
+    struct stat st;
+    if (stat(ARMADA_OVERLAY_CONF, &st) != 0) {
+        last_mtime = {};
+        enabled = false;
+        return enabled;
+    }
+    if (st.st_mtim.tv_sec == last_mtime.tv_sec && st.st_mtim.tv_nsec == last_mtime.tv_nsec)
+        return enabled;
+    last_mtime = st.st_mtim;
+
+    enabled = false;
+    std::ifstream conf(ARMADA_OVERLAY_CONF);
+    std::string line;
+    while (std::getline(conf, line)) {
+        line.erase(std::remove_if(line.begin(), line.end(), ::isspace), line.end());
+        if (line == "steam_ui=1")
+            enabled = true;
+        else if (line == "steam_ui=0")
+            enabled = false;
+    }
+    return enabled;
+}
 std::mutex mangoapp_m;
 std::condition_variable mangoapp_cv;
 static uint8_t raw_msg[1024] = {0};
@@ -215,10 +254,17 @@ static void msg_read_thread(){
                     // msgrcv counts the payload without the leading message type.
                     HUDElements.g_upscaler = msg_size >= offsetof(mangoapp_msg_v1, upscaler) + sizeof(mangoapp_v1->upscaler) - sizeof(long)
                         ? mangoapp_v1->upscaler : -1;
-                    if (!real_params->enabled[OVERLAY_PARAM_ENABLED_mangoapp_steam]){
-                        steam_focused = get_prop("GAMESCOPE_FOCUSED_APP_GFX") == 769;
-                    } else {
+                    if (real_params->enabled[OVERLAY_PARAM_ENABLED_mangoapp_steam] ||
+                        armada_steam_ui_enabled()) {
                         steam_focused = false;
+                    } else {
+                        // One X round trip per gamescope frame is costly; poll focus 4x/s
+                        static std::chrono::steady_clock::time_point last_focus_check;
+                        auto now = std::chrono::steady_clock::now();
+                        if (now - last_focus_check >= std::chrono::milliseconds(250)) {
+                            last_focus_check = now;
+                            steam_focused = get_prop("GAMESCOPE_FOCUSED_APP_GFX") == 769;
+                        }
                     }
 
                     if (msg_size > offsetof(mangoapp_msg_v1, latency_ns))
@@ -388,7 +434,9 @@ int main(int, char**)
     while (!glfwWindowShouldClose(window)){
         real_params = get_params();
         check_keybinds(*real_params);
-        if (!real_params->no_display && new_frame){
+        // Hidden in the Steam UI: pause like no_display rather than drawing an
+        // empty overlay every frame
+        if (!real_params->no_display && !steam_focused && new_frame){
             if (mangoapp_paused){
                 glfwShowWindow(window);
                 render(window, *real_params);
