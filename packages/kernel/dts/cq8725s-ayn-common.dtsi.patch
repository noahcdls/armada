From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: cq8725s: configure the Odin 3 gamepad and DP audio, fix PCIe WAKE# polarity, describe SoCCP, report sleepstate to the ADSP

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -113,7 +113,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			debounce-interval = <15>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -183,6 +182,22 @@
 				sound-dai = <&q6apm>;
 			};
 		};
+
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
 
 	pmic-glink {
@@ -982,7 +997,7 @@
 };
 
 &pcieport0 {
-	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
 	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
@@ -1390,6 +1405,8 @@
 
 	gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
+		axis-range = <1024>;
 
 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
@@ -1469,3 +1486,22 @@
 		reg = <0x72 0x4>;
 	};
 };
+
+/* Linux loads SoCCP on SM8750; auto_boot is off while this is tested */
+&smp2p_soccp {
+	status = "okay";
+};
+
+&remoteproc_soccp {
+	firmware-name = "qcom/sm8750/ayn/odin3/soccp.mbn";
+	status = "okay";
+};
+
+/* Tell the ADSP when the AP suspends, as the vendor kernel does */
+&smp2p_sleepstate_out {
+	status = "okay";
+};
+
+&smp2p_sleepstate {
+	status = "okay";
+};
