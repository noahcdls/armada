From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: cq8725s: configure the Odin 3 gamepad and DP audio, fix PCIe WAKE# polarity, keep the Wi-Fi PMU rails on, reserve suspend debug memory

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -113,7 +113,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			debounce-interval = <15>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -183,6 +182,22 @@
 				sound-dai = <&q6apm>;
 			};
 		};
+
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
 
 	pmic-glink {
@@ -231,6 +246,36 @@
 		};
 	};
 
+	reserved-memory {
+		/*
+		 * Suspend debugging. High DRAM is clear of the boot chain (the
+		 * bootloader loads the initrd just below 0xb8000000) and keeps
+		 * its contents across resets that do not cut DRAM power.
+		 */
+		suspend-trail@8f0000000 {
+			compatible = "armada,suspend-trail";
+			reg = <0x8 0xf0000000 0x0 0x20000>;
+			no-map;
+			/*
+			 * DRAM does not survive the hang's reset; SDAM does. The
+			 * first block this EE may write is used.
+			 */
+			armada,sdam = <&pmk8550_sdam_9800>, <&pmk8550_sdam_8400>,
+				      <&pmk8550_sdam_7d00>;
+		};
+
+		ramoops@8f0100000 {
+			compatible = "ramoops";
+			reg = <0x8 0xf0100000 0x0 0x400000>;
+			console-size = <0x200000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x80000>;
+			record-size = <0x40000>;
+			ecc-size = <16>;
+			no-map;
+		};
+	};
+
 	vdd_fan_5v0: vdd-fan-5v0-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "vdd_fan_5v0";
@@ -287,6 +332,7 @@
 		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
 		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
 
+		/* Re-enabling these four rails at resume can hang the SoC. */
 		vddio-supply = <&vreg_l3f_1p8>;
 		vddio1p2-supply = <&vreg_l2f_1p2>;
 		vddaon-supply = <&vreg_s4d_0p85>;
@@ -565,6 +611,7 @@
 			regulator-name = "vreg_s4d_0p85";
 			regulator-min-microvolt = <852000>;
 			regulator-max-microvolt = <1036000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
@@ -613,6 +660,7 @@
 			regulator-name = "vreg_s5f_0p85";
 			regulator-min-microvolt = <852000>;
 			regulator-max-microvolt = <1000000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
@@ -630,6 +678,7 @@
 			regulator-name = "vreg_l2f_1p2";
 			regulator-min-microvolt = <1200000>;
 			regulator-max-microvolt = <1200000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
@@ -640,6 +689,7 @@
 			regulator-name = "vreg_l3f_1p8";
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
@@ -982,7 +1032,7 @@
 };
 
 &pcieport0 {
-	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
 	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
@@ -1040,6 +1090,26 @@
 		compatible = "qcom,spmi-sdam";
 		reg = <0x9d00>;
 	};
+
+	/*
+	 * Suspend trail candidates. The vendor kernel gives these to the
+	 * AMOLED ECM and LPG pattern tables, neither of which this board
+	 * uses, so they are writable from HLOS and read all zero.
+	 */
+	pmk8550_sdam_7d00: nvram@7d00 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x7d00>;
+	};
+
+	pmk8550_sdam_8400: nvram@8400 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x8400>;
+	};
+
+	pmk8550_sdam_9800: nvram@9800 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x9800>;
+	};
 };
 
 &pmih0108 {
@@ -1390,6 +1460,8 @@
 
 	gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
+		axis-range = <1024>;
 
 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
