From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: cq8725s: configure the Odin 3 gamepad and DP audio, fix PCIe WAKE# polarity, keep the Wi-Fi PMU rails on, trim idle power

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -113,7 +113,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			debounce-interval = <15>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -183,6 +182,22 @@
 				sound-dai = <&q6apm>;
 			};
 		};
+
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
 
 	pmic-glink {
@@ -287,6 +302,7 @@
 		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
 		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
 
+		/* Re-enabling these four rails at resume can hang the SoC. */
 		vddio-supply = <&vreg_l3f_1p8>;
 		vddio1p2-supply = <&vreg_l2f_1p2>;
 		vddaon-supply = <&vreg_s4d_0p85>;
@@ -561,11 +577,13 @@
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		/* WCN7860 rail: let the SMPS drop to PFM at light load, as stock does */
 		vreg_s4d_0p85: smps4 {
 			regulator-name = "vreg_s4d_0p85";
 			regulator-min-microvolt = <852000>;
 			regulator-max-microvolt = <1036000>;
-			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
 		};
 
 		vreg_l1d_1p2: ldo1 {
@@ -609,11 +627,13 @@
 
 		qcom,pmic-id = "f";
 
+		/* WCN7860 rail: let the SMPS drop to PFM at light load, as stock does */
 		vreg_s5f_0p85: smps5 {
 			regulator-name = "vreg_s5f_0p85";
 			regulator-min-microvolt = <852000>;
 			regulator-max-microvolt = <1000000>;
-			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
 		};
 
 		vreg_l1f_0p88: ldo1 {
@@ -630,20 +650,32 @@
 			regulator-name = "vreg_l2f_1p2";
 			regulator-min-microvolt = <1200000>;
 			regulator-max-microvolt = <1200000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
 						   RPMH_REGULATOR_MODE_HPM>;
+
+			/* WCN7860 IO rail, kept on through suspend: idle it in LPM */
+			regulator-state-mem {
+				regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+			};
 		};
 
 		vreg_l3f_1p8: ldo3 {
 			regulator-name = "vreg_l3f_1p8";
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
 						   RPMH_REGULATOR_MODE_HPM>;
+
+			/* WCN7860 IO rail, kept on through suspend: idle it in LPM */
+			regulator-state-mem {
+				regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+			};
 		};
 
 	};
@@ -971,6 +1003,14 @@
 	pinctrl-0 = <&pcie0_default_state>;
 	pinctrl-names = "default";
 
+	/*
+	 * pcie-qcom sets its OPP once, from the trained link: Gen3 x2 holds CX
+	 * at NOM and a 1.97 GB/s DDR peak vote whenever Wi-Fi is up (stock's
+	 * cnss2 drops the link to Gen1 when idle instead). Gen2 x2 (~6.4 Gb/s)
+	 * still exceeds what the WCN7860 moves, at CX LOW_SVS and 1 GB/s.
+	 */
+	max-link-speed = <2>;
+
 	status = "okay";
 };
 
@@ -982,7 +1022,7 @@
 };
 
 &pcieport0 {
-	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
 	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
@@ -1332,6 +1372,17 @@
 		bias-pull-down;
 	};
 
+	/*
+	 * vdd_mcu_3v3 is off in s2idle: park the gamepad UART as pulled-down
+	 * inputs so it does not back-power the MCU through its UART pins.
+	 */
+	qup_uart15_sleep: qup-uart15-sleep-state {
+		pins = "gpio30", "gpio31";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
 	mcu_pwr_default: mcu-pwr-default-state {
 		pins = "gpio83";
 		function = "gpio";
@@ -1386,10 +1437,16 @@
 };
 
 &uart15 {
+	pinctrl-0 = <&qup_uart15_default>;
+	pinctrl-1 = <&qup_uart15_sleep>;
+	pinctrl-names = "default", "sleep";
+
 	status = "okay";
 
 	gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
+		axis-range = <1024>;
 
 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
