From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: cq8725s: configure the Odin 3 gamepad and DP audio, fix PCIe WAKE# polarity, reserve suspend debug memory, disable the unused WSA macros, fix the swapped USB QMP PHY supplies

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -113,7 +113,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			debounce-interval = <15>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -183,6 +182,22 @@
 				sound-dai = <&q6apm>;
 			};
 		};
+
+		dp-dai-link {
+			link-name = "DisplayPort Playback";
+
+			codec {
+				sound-dai = <&mdss_dp0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
 	};
 
 	pmic-glink {
@@ -231,6 +246,36 @@
 		};
 	};
 
+	reserved-memory {
+		/*
+		 * Suspend debugging. High DRAM is clear of the boot chain (the
+		 * bootloader loads the initrd just below 0xb8000000) and keeps
+		 * its contents across resets that do not cut DRAM power.
+		 */
+		suspend-trail@8f0000000 {
+			compatible = "armada,suspend-trail";
+			reg = <0x8 0xf0000000 0x0 0x20000>;
+			no-map;
+			/*
+			 * DRAM does not survive the hang's reset; SDAM does. The
+			 * first block this EE may write is used.
+			 */
+			armada,sdam = <&pmk8550_sdam_9800>, <&pmk8550_sdam_8400>,
+				      <&pmk8550_sdam_7d00>;
+		};
+
+		ramoops@8f0100000 {
+			compatible = "ramoops";
+			reg = <0x8 0xf0100000 0x0 0x400000>;
+			console-size = <0x200000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x80000>;
+			record-size = <0x40000>;
+			ecc-size = <16>;
+			no-map;
+		};
+	};
+
 	vdd_fan_5v0: vdd-fan-5v0-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "vdd_fan_5v0";
@@ -932,6 +977,19 @@
 	qcom,dmic-sample-rate = <4800000>;
 };
 
+/*
+ * The speakers are I2S amplifiers and the sound card links only the RX/TX
+ * macros. Bound WSA macros hold their q6prm TX MCLK votes permanently, which
+ * keeps the ADSP waking about once a second through s2idle.
+ */
+&lpass_wsa2macro {
+	status = "disabled";
+};
+
+&lpass_wsamacro {
+	status = "disabled";
+};
+
 &mdss {
 	status = "okay";
 };
@@ -982,7 +1040,7 @@
 };
 
 &pcieport0 {
-	wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
+	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
 	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
@@ -1040,6 +1098,26 @@
 		compatible = "qcom,spmi-sdam";
 		reg = <0x9d00>;
 	};
+
+	/*
+	 * Suspend trail candidates. The vendor kernel gives these to the
+	 * AMOLED ECM and LPG pattern tables, neither of which this board
+	 * uses, so they are writable from HLOS and read all zero.
+	 */
+	pmk8550_sdam_7d00: nvram@7d00 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x7d00>;
+	};
+
+	pmk8550_sdam_8400: nvram@8400 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x8400>;
+	};
+
+	pmk8550_sdam_9800: nvram@9800 {
+		compatible = "qcom,spmi-sdam";
+		reg = <0x9800>;
+	};
 };
 
 &pmih0108 {
@@ -1390,6 +1468,8 @@
 
 	gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
+		axis-range = <1024>;
 
 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
@@ -1430,8 +1510,8 @@
 };
 
 &usb_dp_qmpphy {
-	vdda-phy-supply = <&vreg_l3g_1p2>;
-	vdda-pll-supply = <&vreg_l2d_0p88>;
+	vdda-phy-supply = <&vreg_l2d_0p88>;
+	vdda-pll-supply = <&vreg_l3g_1p2>;
 
 	mode-switch;
 
