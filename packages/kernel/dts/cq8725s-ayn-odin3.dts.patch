From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin3: enable DPU dithering, codec and WCN rail sleep modes, the SoCCP firmware and the display sequencer handoff

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -217,6 +217,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
 
 	vddio-supply = <&vreg_l12b_1p8>;
@@ -350,3 +353,207 @@
 		};
 	};
 };
+
+/* The codec keeps these rails enabled through s2idle; idle them in LPM */
+&vreg_bob1 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l15b_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l2i_1p2 {
+	regulator-state-mem {
+		/* Trial: drop the codec-only APPS enable vote in s2idle. */
+		regulator-off-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s3g_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s7i_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+/*
+ * The WCN7860 PMU rails and s1d stay enabled through s2idle (Bluetooth
+ * keeps the chip powered, Wi-Fi is off) and would sit in HPM/PWM; idle
+ * them in LPM like the codec rails
+ */
+&vreg_l2f_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l3f_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s1d_0p97 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s4d_0p85 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s5f_0p85 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+/*
+ * Nothing in Linux uses these; the vendor DT has them on in LPM, while the
+ * bootloader leaves them in HPM. A rail Linux never votes on keeps that
+ * vote through s2idle, so own them: on in LPM while awake, off while asleep.
+ * l2j is the SPSS sensors supply; SPSS is not loaded here.
+ */
+&vreg_l1b_1p8 {
+	regulator-always-on;
+	regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+
+	regulator-state-mem {
+		regulator-off-in-suspend;
+	};
+};
+
+&vreg_l2b_3p0 {
+	regulator-always-on;
+	regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+
+	regulator-state-mem {
+		regulator-off-in-suspend;
+	};
+};
+
+&vreg_l2j_1p2 {
+	regulator-always-on;
+	regulator-initial-mode = <RPMH_REGULATOR_MODE_LPM>;
+
+	regulator-state-mem {
+		regulator-off-in-suspend;
+	};
+};
+
+/*
+ * Pins that would feed powered-off parts or fight their own pull through
+ * s2idle: the gamepad MCU UART (its 3.3 V rail is cut in suspend, while
+ * TX idles high), and outputs whose default pull opposes the level driven
+ * (panel rail enables, speaker amp resets).
+ */
+&tlmm {
+	qup_uart15_sleep: qup-uart15-sleep-state {
+		pins = "gpio30", "gpio31";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+		input-enable;
+	};
+
+	bl_en_default: bl-en-default-state {
+		pins = "gpio56";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	disp_en_default: disp-en-default-state {
+		pins = "gpio97";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	spk_amp_l_rst_default: spk-amp-l-rst-default-state {
+		pins = "gpio128";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	spk_amp_r_rst_default: spk-amp-r-rst-default-state {
+		pins = "gpio126";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+&uart15 {
+	pinctrl-0 = <&qup_uart15_default>;
+	pinctrl-1 = <&qup_uart15_sleep>;
+	pinctrl-names = "default", "sleep";
+};
+
+&vdd_bl_5v0 {
+	pinctrl-0 = <&bl_en_default>;
+	pinctrl-names = "default";
+};
+
+&vdd_disp_2v8 {
+	pinctrl-0 = <&disp_en_default>;
+	pinctrl-names = "default";
+};
+
+&spk_amp_l {
+	pinctrl-0 = <&spk_amp_l_rst_default>;
+	pinctrl-names = "default";
+};
+
+&spk_amp_r {
+	pinctrl-0 = <&spk_amp_r_rst_default>;
+	pinctrl-names = "default";
+};
+
+/* Replaces the bootloader's early SoCCP image, which blocks SoC deep sleep */
+&remoteproc_soccp {
+	firmware-name = "qcom/sm8750/ayn/odin3/soccp.mbn";
+};
+
+/*
+ * Display sequencer handoff at suspend (0566), so the display reports idle
+ * and the SoC reaches AOSS deep sleep. The last region is the MDSS GDSC
+ * register in dispcc.
+ */
+&soc {
+	display-cesta@af20000 {
+		compatible = "armada,sm8750-disp-cesta";
+		reg = <0x0 0x0af20000 0x0 0x1000>,
+		      <0x0 0x0af21000 0x0 0x7000>,
+		      <0x0 0x0af30000 0x0 0x7000>,
+		      <0x0 0x0af09000 0x0 0x8>;
+		reg-names = "rscc", "crm", "wrapper", "gdsc";
+		power-domains = <&rpmhpd RPMHPD_MMCX>;
+		required-opps = <&rpmhpd_opp_low_svs>;
+		armada,mdss = <&mdss>;
+	};
+};
