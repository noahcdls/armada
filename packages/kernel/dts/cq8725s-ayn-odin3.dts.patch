From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin3: enable DPU dithering, describe the SoCCP, reserve the vendor lost regions

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -217,6 +217,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
 
 	vddio-supply = <&vreg_l12b_1p8>;
@@ -350,3 +353,91 @@
 		};
 	};
 };
+
+/ {
+	reserved-memory {
+		/* Reserved no-map by the vendor DT but handed to Linux by mainline */
+		lost-reg@9b09c000 {
+			reg = <0x0 0x9b09c000 0x0 0x4000>;
+			no-map;
+		};
+
+		lost-reg@9eb80000 {
+			reg = <0x0 0x9eb80000 0x0 0x80000>;
+			no-map;
+		};
+	};
+
+	/* SMP2P edge to the SoCCP, from the vendor DT (IPCC client 46) */
+	smp2p-soccp {
+		compatible = "qcom,smp2p";
+
+		interrupts-extended = <&ipcc 46 IPCC_MPROC_SIGNAL_SMP2P
+					     IRQ_TYPE_EDGE_RISING>;
+
+		mboxes = <&ipcc 46 IPCC_MPROC_SIGNAL_SMP2P>;
+
+		qcom,smem = <617>, <616>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <19>;
+
+		soccp_smp2p_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		soccp_smp2p_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
+	/*
+	 * The vendor kernel reloads soccp.mbn (PAS 51) at boot; the image the
+	 * bootloader leaves running ignores SMP2P. Started by hand for now.
+	 */
+	remoteproc_soccp: remoteproc-soccp {
+		compatible = "qcom,sm8750-soccp-pas";
+
+		interrupts-extended = <&intc GIC_SPI 167 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "wdog",
+				  "fatal",
+				  "ready",
+				  "handover",
+				  "stop-ack";
+
+		clocks = <&rpmhcc RPMH_CXO_CLK>;
+		clock-names = "xo";
+
+		power-domains = <&rpmhpd RPMHPD_CX>,
+				<&rpmhpd RPMHPD_MX>;
+		power-domain-names = "cx",
+				     "mx";
+
+		interconnects = <&aggre2_noc MASTER_SOCCP_AGGR_NOC QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+
+		memory-region = <&soccp_mem>;
+		firmware-name = "qcom/sm8750/ayn/odin3/soccp.mbn";
+
+		qcom,smem-states = <&soccp_smp2p_out 0>;
+		qcom,smem-state-names = "stop";
+	};
+
+	/* The bootloader leaves the SoCCP in D0; park it in D3 like the vendor kernel */
+	soccp-dstate@1fda000 {
+		compatible = "armada,sm8750-soccp-dstate";
+		reg = <0x0 0x01fda000 0x0 0x4>;
+
+		qcom,smem-states = <&soccp_smp2p_out 9>, <&soccp_smp2p_out 10>;
+		qcom,smem-state-names = "sleep", "wakeup";
+
+		interconnects = <&aggre2_noc MASTER_SOCCP_AGGR_NOC QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+	};
+};
