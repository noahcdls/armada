From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin3: enable DPU dithering, codec and WCN rail sleep modes and the SoCCP firmware

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -217,6 +217,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
 
 	vddio-supply = <&vreg_l12b_1p8>;
@@ -350,3 +353,120 @@
 		};
 	};
 };
+
+/* The codec keeps these rails enabled through s2idle; idle them in LPM */
+&vreg_bob1 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l15b_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l2i_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s3g_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s7i_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+/*
+ * The WCN7860 PMU rails and s1d stay enabled through s2idle (Bluetooth
+ * keeps the chip powered, Wi-Fi is off) and would sit in HPM/PWM; idle
+ * them in LPM like the codec rails
+ */
+&vreg_l2f_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l3f_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s1d_0p97 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s4d_0p85 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s5f_0p85 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+/* Experiment: also idle the USB PHY PLL rail in LPM to see whether aosd is reachable */
+&vreg_l3g_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+/* Test: report the APPS sleep state to the ADSP like the downstream kernel */
+&{/smp2p-adsp} {
+	sleepstate_smp2p_out: sleepstate-out {
+		qcom,entry-name = "sleepstate";
+		#qcom,smem-state-cells = <1>;
+	};
+
+	sleepstate_smp2p_in: sleepstate-in {
+		qcom,entry-name = "sleepstate_see";
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
+
+/ {
+	smp2p-sleepstate {
+		compatible = "qcom,smp2p-sleepstate";
+		qcom,smem-states = <&sleepstate_smp2p_out 0>;
+		interrupts-extended = <&sleepstate_smp2p_in 0 IRQ_TYPE_EDGE_BOTH>;
+		interrupt-names = "smp2p-sleepstate-in";
+	};
+};
+/* Replaces the bootloader's early SoCCP image, which blocks SoC deep sleep */
+&remoteproc_soccp {
+	firmware-name = "qcom/sm8750/ayn/odin3/soccp.mbn";
+
+	/* Test: downstream D0/D3 request bits, for the soccp_dstate file (0560) */
+	qcom,smem-states = <&soccp_smp2p_out 0>,
+			   <&soccp_smp2p_out 10>,
+			   <&soccp_smp2p_out 9>;
+	qcom,smem-state-names = "stop", "wakeup", "sleep";
+};
