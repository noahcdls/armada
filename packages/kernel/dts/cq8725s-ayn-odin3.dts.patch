From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin3: enable DPU dithering, codec rail sleep modes, vendor always-on rails, the SMP2P sleep state and the SoCCP

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -217,6 +217,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
 
 	vddio-supply = <&vreg_l12b_1p8>;
@@ -350,3 +353,147 @@
 		};
 	};
 };
+
+/* The codec keeps these rails enabled through s2idle; idle them in LPM */
+&vreg_bob1 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l15b_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_l2i_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s3g_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_s7i_1p2 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+/*
+ * The vendor sun regulator setup keeps these on independent of any
+ * consumer (L1F_AO/L3G_AO active-set always-on, L2F/L3F always-on).
+ * Upstream drops L1F/L3G whenever the PHYs that use them are off, so
+ * nothing votes them back on before the CPUs run on wake from s2idle.
+ */
+&vreg_l1f_0p88 {
+	regulator-always-on;
+};
+
+&vreg_l2f_1p2 {
+	regulator-always-on;
+};
+
+&vreg_l3f_1p8 {
+	regulator-always-on;
+};
+
+&vreg_l3g_1p2 {
+	regulator-always-on;
+};
+
+/ {
+	smp2p-adsp {
+		sleepstate_smp2p_out: sleepstate-out {
+			qcom,entry-name = "sleepstate";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		sleepstate_smp2p_in: sleepstate-in {
+			qcom,entry-name = "sleepstate_see";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
+	/* Tell the ADSP when HLOS suspends, as the vendor kernel does */
+	smp2p-sleepstate {
+		compatible = "qcom,smp2p-sleepstate";
+		qcom,smem-states = <&sleepstate_smp2p_out 0>;
+		interrupts-extended = <&sleepstate_smp2p_in 0 IRQ_TYPE_EDGE_BOTH>;
+		interrupt-names = "smp2p-sleepstate-in";
+	};
+};
+
+/ {
+	/* SMP2P edge to the SoCCP, from the vendor DT (IPCC client 46) */
+	smp2p-soccp {
+		compatible = "qcom,smp2p";
+
+		interrupts-extended = <&ipcc 46 IPCC_MPROC_SIGNAL_SMP2P
+					     IRQ_TYPE_EDGE_RISING>;
+
+		mboxes = <&ipcc 46 IPCC_MPROC_SIGNAL_SMP2P>;
+
+		qcom,smem = <617>, <616>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <19>;
+
+		soccp_smp2p_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		soccp_smp2p_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
+	/*
+	 * The vendor kernel reloads soccp.mbn (PAS 51) at boot; the image the
+	 * bootloader leaves running ignores SMP2P. Started by hand for now.
+	 */
+	remoteproc_soccp: remoteproc-soccp {
+		compatible = "qcom,sm8750-soccp-pas";
+
+		interrupts-extended = <&intc GIC_SPI 167 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+				      <&soccp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "wdog",
+				  "fatal",
+				  "ready",
+				  "handover",
+				  "stop-ack";
+
+		clocks = <&rpmhcc RPMH_CXO_CLK>;
+		clock-names = "xo";
+
+		power-domains = <&rpmhpd RPMHPD_CX>,
+				<&rpmhpd RPMHPD_MX>;
+		power-domain-names = "cx",
+				     "mx";
+
+		interconnects = <&aggre2_noc MASTER_SOCCP_AGGR_NOC QCOM_ICC_TAG_ALWAYS
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+
+		memory-region = <&soccp_mem>;
+		firmware-name = "qcom/sm8750/ayn/odin3/soccp.mbn";
+
+		qcom,smem-states = <&soccp_smp2p_out 0>;
+		qcom,smem-state-names = "stop";
+	};
+};
