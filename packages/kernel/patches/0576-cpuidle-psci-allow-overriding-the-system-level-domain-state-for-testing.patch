From: Armada <noreply@armada.local>
Subject: [PATCH] cpuidle: psci: allow overriding the system-level domain state for testing

Add cpuidle_psci.sys_state_override: when non-zero, it replaces the PSCI
power_state of any composite domain state at power level 2 (the APSS-off
state, 0x0200C354 on SM8750), so variants of the deepest s2idle state can
be tried at runtime. Test only; drop before merging.
---
--- a/drivers/cpuidle/cpuidle-psci.c
+++ b/drivers/cpuidle/cpuidle-psci.c
@@ -56,6 +56,14 @@ void psci_set_domain_state(struct generi
 	ds->state = state;
 }
 
+/*
+ * s2idle testing: replace the composite PSCI state whenever it requests
+ * power level 2 (the APSS-off domain state) with this value, if set.
+ */
+static unsigned int sys_state_override;
+module_param(sys_state_override, uint, 0644);
+MODULE_PARM_DESC(sys_state_override, "Replacement PSCI power_state for power-level-2 domain states (0: off)");
+
 static inline void psci_clear_domain_state(void)
 {
 	__this_cpu_write(psci_domain_state.state, 0);
@@ -86,6 +94,9 @@ static __cpuidle int __psci_enter_domain
 	if (ds->state)
 		state = ds->state;
 
+	if (READ_ONCE(sys_state_override) && ((state >> 24) & 0xf) == 2)
+		state = READ_ONCE(sys_state_override);
+
 	trace_psci_domain_idle_enter(dev->cpu, state, s2idle);
 	ret = psci_cpu_suspend_enter(state) ? -1 : idx;
 	trace_psci_domain_idle_exit(dev->cpu, state, s2idle);
