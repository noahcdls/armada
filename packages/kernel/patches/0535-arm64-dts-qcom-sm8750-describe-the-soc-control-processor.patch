From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: sm8750: describe the SoC Control Processor

Add the SMP2P channel to the SoC Control Processor (SoCCP) and its PAS
remoteproc node. The SMEM items (617/616), IPCC client (46), remote PID
(19), watchdog interrupt (SPI 167), SMP2P interrupt and state bits,
CX/MX supplies and DDR path come from the SM8750 vendor devicetree
(qcom,smp2p-soccp and remoteproc-soccp@a3380000). On SM8750 the vendor
kernel, not the boot firmware, loads SoCCP; on the AYN Odin 3 nothing
starts it under Linux and its TCSR state word stays at the D0 reset
value. Both nodes are disabled here.
---
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -675,6 +675,33 @@
 		/* TODO: smem mailbox in and out */
 	};
 
+	/* SMEM items, IPCC client and PID from the SM8750 vendor devicetree */
+	smp2p_soccp: smp2p-soccp {
+		compatible = "qcom,smp2p";
+
+		interrupts-extended = <&ipcc 46 IPCC_MPROC_SIGNAL_SMP2P
+					     IRQ_TYPE_EDGE_RISING>;
+
+		mboxes = <&ipcc 46 IPCC_MPROC_SIGNAL_SMP2P>;
+
+		qcom,smem = <617>, <616>;
+		qcom,local-pid = <0>;
+		qcom,remote-pid = <19>;
+
+		status = "disabled";
+
+		smp2p_soccp_out: master-kernel {
+			qcom,entry-name = "master-kernel";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		smp2p_soccp_in: slave-kernel {
+			qcom,entry-name = "slave-kernel";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
+
 	soc: soc@0 {
 		compatible = "simple-bus";
 
@@ -6133,6 +6160,40 @@
 			#interconnect-cells = <2>;
 		};
 
+		remoteproc_soccp: remoteproc@a3380000 {
+			compatible = "qcom,sm8750-soccp-pas";
+			reg = <0x0 0xa3380000 0x0 0x10000>;
+
+			interrupts-extended = <&intc GIC_SPI 167 IRQ_TYPE_EDGE_RISING>,
+					      <&smp2p_soccp_in 0 IRQ_TYPE_EDGE_RISING>,
+					      <&smp2p_soccp_in 1 IRQ_TYPE_EDGE_RISING>,
+					      <&smp2p_soccp_in 2 IRQ_TYPE_EDGE_RISING>,
+					      <&smp2p_soccp_in 3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "wdog",
+					  "fatal",
+					  "ready",
+					  "handover",
+					  "stop-ack";
+
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-names = "xo";
+
+			interconnects = <&aggre2_noc MASTER_SOCCP_AGGR_NOC QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+
+			power-domains = <&rpmhpd RPMHPD_CX>,
+					<&rpmhpd RPMHPD_MX>;
+			power-domain-names = "cx",
+					     "mx";
+
+			memory-region = <&soccp_mem>;
+
+			qcom,smem-states = <&smp2p_soccp_out 0>;
+			qcom,smem-state-names = "stop";
+
+			status = "disabled";
+		};
+
 		remoteproc_cdsp: remoteproc@32300000 {
 			compatible = "qcom,sm8750-cdsp-pas", "qcom,sm8650-cdsp-pas";
 			reg = <0x0 0x32300000 0x0 0x10000>;
