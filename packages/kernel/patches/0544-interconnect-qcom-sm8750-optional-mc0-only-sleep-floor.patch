From: Armada <noreply@armada.local>
Subject: [PATCH] interconnect: qcom: sm8750: optional MC0-only sleep floor

The SM8750 s2idle hang on wake needs only a nonzero MC0 vote in the
sleep set. The PCIe suspend OPP floor also keeps SH0 (LLCC) and CN0 at 1
through suspend, which may cost power.

Add keepalive_sleep to the MC0 BCM: when set, MC0 keeps a one-unit sleep
vote while every other BCM can drop. It is gated by
icc_bcm_voter.sleep_keepalive (default N, writable at runtime), so this
patch changes nothing by default. To compare it with the PCIe floor, set
pcie_qcom.suspend_opp_floor=N and icc_bcm_voter.sleep_keepalive=Y.

Based on the earlier 0549/0551 test patches. Test only.
---
diff --git a/drivers/interconnect/qcom/bcm-voter.c b/drivers/interconnect/qcom/bcm-voter.c
index a2d437a..c828c53 100644
--- a/drivers/interconnect/qcom/bcm-voter.c
+++ b/drivers/interconnect/qcom/bcm-voter.c
@@ -58,6 +58,16 @@ static u64 bcm_div(u64 num, u32 base)
 	return num;
 }
 
+/*
+ * Debug knob: keep a minimal sleep-set vote on keepalive_sleep BCMs, as an
+ * alternative to the PCIe suspend OPP floor. It only takes effect at the
+ * next commit of a BCM.
+ */
+static bool sleep_keepalive;
+module_param(sleep_keepalive, bool, 0644);
+MODULE_PARM_DESC(sleep_keepalive,
+		 "Keep a minimal sleep-set vote on keepalive_sleep BCMs (default: N)");
+
 /* BCMs with enable_mask use one-hot-encoding for on/off signaling */
 static void bcm_aggregate_mask(struct qcom_icc_bcm *bcm)
 {
@@ -122,6 +132,13 @@ static void bcm_aggregate(struct qcom_icc_bcm *bcm)
 		bcm->vote_y[QCOM_ICC_BUCKET_AMC] = 1;
 		bcm->vote_y[QCOM_ICC_BUCKET_WAKE] = 1;
 	}
+
+	if (bcm->keepalive_sleep && sleep_keepalive &&
+	    bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] == 0 &&
+	    bcm->vote_y[QCOM_ICC_BUCKET_SLEEP] == 0) {
+		bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] = 1;
+		bcm->vote_y[QCOM_ICC_BUCKET_SLEEP] = 1;
+	}
 }
 
 static inline void tcs_cmd_gen(struct tcs_cmd *cmd, u64 vote_x, u64 vote_y,
diff --git a/drivers/interconnect/qcom/icc-rpmh.h b/drivers/interconnect/qcom/icc-rpmh.h
index 09d8791..1661d0c 100644
--- a/drivers/interconnect/qcom/icc-rpmh.h
+++ b/drivers/interconnect/qcom/icc-rpmh.h
@@ -118,6 +118,7 @@ struct qcom_icc_node {
  * @enable_mask: optional mask to send as vote instead of vote_x/vote_y
  * @dirty: flag used to indicate whether the bcm needs to be committed
  * @keepalive: flag used to indicate whether a keepalive is required
+ * @keepalive_sleep: also keep a minimal vote in the sleep set
  * @aux_data: auxiliary data used when calculating threshold values and
  * communicating with RPMh
  * @list: used to link to other bcms when compiling lists for commit
@@ -135,6 +136,7 @@ struct qcom_icc_bcm {
 	u32 enable_mask;
 	bool dirty;
 	bool keepalive;
+	bool keepalive_sleep;
 	struct bcm_db aux_data;
 	struct list_head list;
 	struct list_head ws_list;
diff --git a/drivers/interconnect/qcom/sm8750.c b/drivers/interconnect/qcom/sm8750.c
index 1486c0b..c214ba6 100644
--- a/drivers/interconnect/qcom/sm8750.c
+++ b/drivers/interconnect/qcom/sm8750.c
@@ -1084,9 +1084,14 @@ static struct qcom_icc_bcm bcm_lp0 = {
 	.nodes = { &qnm_lpass_lpinoc, &qns_lpass_aggnoc },
 };
 
+/*
+ * s2idle hangs on wake, followed by a reset, once every MC0 vote reaches 0 in
+ * the sleep set. One unit is enough to avoid it.
+ */
 static struct qcom_icc_bcm bcm_mc0 = {
 	.name = "MC0",
 	.keepalive = true,
+	.keepalive_sleep = true,
 	.num_nodes = 1,
 	.nodes = { &ebi },
 };
