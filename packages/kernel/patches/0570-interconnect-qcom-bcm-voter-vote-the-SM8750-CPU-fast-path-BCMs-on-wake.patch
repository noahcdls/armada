From: Armada <noreply@armada.local>
Subject: [PATCH] interconnect: qcom: bcm-voter: vote the SM8750 CPU fast-path BCMs on wake

The vendor SM8750 kernel's dcvs_fp driver places a sleep vote of 0 and a
minimal wake vote (BCM_TCS_CMD(1, 1, 0, 1)) on the MC4 (DDR) and SH5
(LLCC) BCMs that serve the CPU fast path, so every APPS wake from a
sleep that let DDR self-refresh raises them before the CPUs run. Upstream
never votes MC4/SH5. On the AYN Odin 3, s2idle hangs on the APPS wake
whenever every MC0 sleep vote is 0, from any wake source, while the ADSP
(on the MC0 path) wakes fine from the same state.

Let a bcm-voter list such BCMs in "qcom,wake-only-bcms" and place the
same votes at probe. fp_wake_vote toggles the wake vote at runtime for
A/B testing.
---
--- a/drivers/interconnect/qcom/bcm-voter.c
+++ b/drivers/interconnect/qcom/bcm-voter.c
@@ -10,6 +10,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 
+#include <soc/qcom/cmd-db.h>
 #include <soc/qcom/rpmh.h>
 #include <soc/qcom/tcs.h>
 
@@ -63,6 +64,63 @@ static bool sleep_keepalive = true;
 module_param(sleep_keepalive, bool, 0644);
 MODULE_PARM_DESC(sleep_keepalive, "Keep a minimal sleep-set vote on keepalive_sleep BCMs");
 
+/*
+ * Wake-only votes on the BCMs listed in "qcom,wake-only-bcms" (the CPU
+ * fast-path DDR/LLCC BCMs on SM8750): 0 in the sleep set and a minimal
+ * vote in the wake set, as the vendor dcvs_fp driver places at probe.
+ */
+static bool fp_wake_vote = true;
+static struct bcm_voter *fp_voter;
+
+static int bcm_voter_write_wake_only(struct bcm_voter *voter, bool on)
+{
+	struct tcs_cmd cmd = {};
+	const char *name;
+	int i, n, ret;
+
+	n = of_property_count_strings(voter->np, "qcom,wake-only-bcms");
+	for (i = 0; i < n; i++) {
+		if (of_property_read_string_index(voter->np, "qcom,wake-only-bcms",
+						  i, &name))
+			continue;
+
+		cmd.addr = cmd_db_read_addr(name);
+		if (!cmd.addr) {
+			dev_warn(voter->dev, "%s not found in cmd-db\n", name);
+			continue;
+		}
+
+		cmd.data = BCM_TCS_CMD(1, 1, 0, 0);
+		ret = rpmh_write_async(voter->dev, RPMH_SLEEP_STATE, &cmd, 1);
+		if (ret)
+			return ret;
+
+		cmd.data = BCM_TCS_CMD(1, 1, 0, on ? 1 : 0);
+		ret = rpmh_write_async(voter->dev, RPMH_WAKE_ONLY_STATE, &cmd, 1);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int fp_wake_vote_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret || !fp_voter)
+		return ret;
+
+	return bcm_voter_write_wake_only(fp_voter, fp_wake_vote);
+}
+
+static const struct kernel_param_ops fp_wake_vote_ops = {
+	.set = fp_wake_vote_set,
+	.get = param_get_bool,
+};
+module_param_cb(fp_wake_vote, &fp_wake_vote_ops, &fp_wake_vote, 0644);
+MODULE_PARM_DESC(fp_wake_vote, "Vote the qcom,wake-only-bcms BCMs on in the wake set");
+
 /* BCMs with enable_mask use one-hot-encoding for on/off signaling */
 static void bcm_aggregate_mask(struct qcom_icc_bcm *bcm)
 {
@@ -402,6 +460,15 @@ static int qcom_icc_bcm_voter_probe(stru
 	list_add_tail(&voter->voter_node, &bcm_voters);
 	mutex_unlock(&bcm_voter_lock);
 
+	if (of_property_present(np, "qcom,wake-only-bcms")) {
+		int ret = bcm_voter_write_wake_only(voter, fp_wake_vote);
+
+		if (ret)
+			dev_warn(&pdev->dev, "wake-only BCM votes failed: %d\n", ret);
+		else
+			fp_voter = voter;
+	}
+
 	return 0;
 }
 
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -5809,6 +5809,8 @@
 
 			apps_bcm_voter: bcm-voter {
 				compatible = "qcom,bcm-voter";
+				/* CPU fast-path DDR/LLCC BCMs, voted in the wake set */
+				qcom,wake-only-bcms = "MC4", "SH5";
 			};
 
 			rpmhcc: clock-controller {
