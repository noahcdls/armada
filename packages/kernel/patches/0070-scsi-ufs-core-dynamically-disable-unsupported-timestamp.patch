From: Armada <noreply@armada.local>
Subject: [PATCH] scsi: ufs: core: dynamically disable unsupported timestamp

The UFS qTimestamp attribute is optional. Some UFS 4.0 devices advertise
the version but reject the attribute with QUERY_RESULT_INVALID_IDN. Once
the device returns -EOPNOTSUPP, remember that capability result and avoid
retrying the optional write on every boot and resume.

Based on Stanley Jhu's upstream patch:
https://lkml.iu.edu/2609.1/09329.html

---
diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index 27f2058176d4..06007369f26a 100644
--- a/~repos/linux/drivers/ufs/core/ufshcd.c
+++ b/~/repos/linux/drivers/ufs/core/ufshcd.c
@@ -8844,6 +8844,9 @@ static int ufs_get_device_desc(struct ufs_hba *hba)
 
 	ufs_fixup_device_setup(hba);
 
+	dev_info->timestamp_sup = dev_info->wspecversion >= 0x400 &&
+		!(hba->dev_quirks & UFS_DEVICE_QUIRK_NO_TIMESTAMP_SUPPORT);
+
 	ufshcd_wb_probe(hba, desc_buf);
 
 	ufshcd_temp_notif_probe(hba, desc_buf);
@@ -9144,14 +9155,15 @@ static void ufshcd_set_timestamp_attr(struct ufs_hba *hba)
 	u64 ts_ns;
 	int err;
 
-	if (dev_info->wspecversion < 0x400 ||
-	    hba->dev_quirks & UFS_DEVICE_QUIRK_NO_TIMESTAMP_SUPPORT)
+	if (!dev_info->timestamp_sup)
 		return;
 
 	ts_ns = ktime_get_real_ns();
 	err = ufshcd_query_attr_qword(hba, UPIU_QUERY_OPCODE_WRITE_ATTR,
 				      QUERY_ATTR_IDN_TIMESTAMP, 0, 0, &ts_ns);
-	if (err)
+	if (err == -EOPNOTSUPP)
+		dev_info->timestamp_sup = false;
+	else if (err)
 		dev_err(hba->dev, "%s: failed to set timestamp %d\n",
 			__func__, err);
 }
diff --git a/include/ufs/ufs.h b/include/ufs/ufs.h
index 0d48e137d66d..5de8ea4c399a 100644
--- a/~repos/linux/include/ufs/ufs.h
+++ b/~repos/linux/include/ufs/ufs.h
@@ -656,6 +656,7 @@ struct ufs_dev_info {
 	u8 rtt_cap; /* bDeviceRTTCap */
 
 	bool hid_sup;
+	bool timestamp_sup;
 
 	/* Unique device ID string (manufacturer+model+serial+version+date) */
 	char *device_id;
