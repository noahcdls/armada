From: Armada <noreply@armada.local>
Subject: [PATCH] PCI: qcom: honour an opp-suspend OPP while the link stays up in s2idle

On OPP platforms qcom_pcie_suspend_noirq() drops the OPP to NULL for
non-S2RAM suspend, voting average/peak bandwidth of 0/0 on the PCIe
memory path. These OPP votes are the PCIe controller's only DDR/LLCC
contribution to the RPMh sleep set. When the link is kept up through
s2idle (an endpoint vetoed D3cold), the controller and endpoint stay
live but the memory path loses its sleep vote. Once nothing else holds
DDR, the SM8550 AOP never hands control back after the CPU cluster
collapses, and the device hard resets on wake. The vendor kernel keeps
an 800 kBps PCIe vote in this state for the same reason.

When the link is kept up for non-S2RAM suspend, select an OPP marked
opp-suspend, as modeled by the OPP core. Keep the drop to NULL when the
DT defines no suspend OPP.

In D3cold the controller is deinitialised, its clocks and PHY are off
and the endpoint is in L2/L3, so nothing on the PCIe side can reach
DDR. The suspend OPP's DDR bandwidth and its CX required-opps would
otherwise sit in the sleep set and veto the SoC's DDR, CXSD and AOSD
sleep states for the whole suspend. On the Odin 3, however, dropping
both leaves the SoC unable to wake from s2idle (it needs a long press
to restart), so which half is load-bearing is still being bisected.
pcie_qcom.d3cold_mem_floor (writable at runtime) selects what D3cold
keeps: 0 nothing, 1 the whole suspend OPP (default, the known-good
behaviour), 2 only its memory-path bandwidth, 3 only its CX level. The
bandwidth-only floor uses its own
"pcie-mem" request so it never touches pcie->icc_mem, and resume clears
it before restoring the OPP.

Non-obvious choices:
- Do not populate pcie->icc_mem as an alternative on OPP platforms:
  qcom_pcie_icc_opp_update() takes the icc_mem branch when that handle
  is present, bypassing OPP updates and pinning the memory-path vote at
  its probe-time maximum.
- The helper is guarded on pm_suspend_target_state so S2RAM still drops
  the OPP entirely.
- The suspend OPP is resolved with dev_pm_opp_get_suspend_opp_freq()
  plus dev_pm_opp_find_freq_exact(); the synthetic opp-hz in the
  companion DT keeps that frequency unique within the table.

The root-cause analysis and the opp-suspend approach come from Luke
Johnson's fix for this hardware in thorch
(packages/linux-thorch/patches/0220-PCI-qcom-use-suspend-opp-for-non-s2ram.patch);
this is an independent implementation for Linux 7.2.
---
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -20,11 +20,13 @@
 #include <linux/kernel.h>
 #include <linux/limits.h>
 #include <linux/init.h>
+#include <linux/moduleparam.h>
 #include <linux/of.h>
 #include <linux/of_pci.h>
 #include <linux/pci.h>
 #include <linux/pci-ecam.h>
 #include <linux/pci-pwrctrl.h>
+#include <linux/pm_domain.h>
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
 #include <linux/platform_device.h>
@@ -287,6 +289,7 @@
 	union qcom_pcie_resources res;
 	struct icc_path *icc_mem;
 	struct icc_path *icc_cpu;
+	struct icc_path *icc_floor;
 	const struct qcom_pcie_cfg *cfg;
 	struct dentry *debugfs;
 	struct list_head ports;
@@ -2132,6 +2135,13 @@
 			goto err_pm_runtime_put;
 		}
 
+		/* Separate request so a D3cold floor never touches pcie->icc_mem */
+		pcie->icc_floor = devm_of_icc_get(dev, "pcie-mem");
+		if (IS_ERR(pcie->icc_floor)) {
+			ret = PTR_ERR(pcie->icc_floor);
+			goto err_pm_runtime_put;
+		}
+
 		pcie->use_pm_opp = true;
 	} else {
 		/* Skip ICC init if OPP is supported as it is handled by OPP */
@@ -2197,6 +2207,83 @@
 	return ret;
 }
 
+enum qcom_pcie_d3cold_floor {
+	QCOM_PCIE_D3COLD_FLOOR_NONE,
+	QCOM_PCIE_D3COLD_FLOOR_OPP,
+	QCOM_PCIE_D3COLD_FLOOR_BW,
+	QCOM_PCIE_D3COLD_FLOOR_CX,
+};
+
+/* Any DDR/CX sleep-set vote left in D3cold vetoes the SoC's DDR, CXSD and AOSD states */
+static unsigned int d3cold_mem_floor = QCOM_PCIE_D3COLD_FLOOR_OPP;
+module_param(d3cold_mem_floor, uint, 0644);
+MODULE_PARM_DESC(d3cold_mem_floor,
+		 "Suspend OPP votes kept while the link is in D3cold: 0 none, 1 whole OPP (default), 2 memory bandwidth only, 3 CX level only");
+
+static struct dev_pm_opp *qcom_pcie_get_suspend_opp(struct device *dev)
+{
+	unsigned long freq = dev_pm_opp_get_suspend_opp_freq(dev);
+
+	if (!freq)
+		return NULL;
+
+	return dev_pm_opp_find_freq_exact(dev, freq, true);
+}
+
+/*
+ * A link kept up through s2idle still needs its DDR/LLCC sleep-set votes, so
+ * select the DT suspend OPP. Suspend-to-RAM tears the link down and keeps
+ * dropping the OPP.
+ */
+static int qcom_pcie_set_suspend_opp(struct qcom_pcie *pcie)
+{
+	struct device *dev = pcie->pci->dev;
+	struct dev_pm_opp *opp;
+	int ret;
+
+	if (pm_suspend_target_state == PM_SUSPEND_MEM)
+		return dev_pm_opp_set_opp(dev, NULL);
+
+	opp = qcom_pcie_get_suspend_opp(dev);
+	if (IS_ERR_OR_NULL(opp))
+		return opp ? PTR_ERR(opp) : dev_pm_opp_set_opp(dev, NULL);
+
+	ret = dev_pm_opp_set_opp(dev, opp);
+	dev_pm_opp_put(opp);
+
+	return ret;
+}
+
+/* Drop the OPP in D3cold, optionally keeping one half of the suspend OPP */
+static int qcom_pcie_set_d3cold_floor(struct qcom_pcie *pcie)
+{
+	struct device *dev = pcie->pci->dev;
+	unsigned int mode = READ_ONCE(d3cold_mem_floor);
+	struct dev_pm_opp *opp;
+	int ret;
+
+	if (mode == QCOM_PCIE_D3COLD_FLOOR_OPP)
+		return qcom_pcie_set_suspend_opp(pcie);
+
+	ret = dev_pm_opp_set_opp(dev, NULL);
+	if (ret || pm_suspend_target_state == PM_SUSPEND_MEM ||
+	    (mode != QCOM_PCIE_D3COLD_FLOOR_BW && mode != QCOM_PCIE_D3COLD_FLOOR_CX))
+		return ret;
+
+	opp = qcom_pcie_get_suspend_opp(dev);
+	if (IS_ERR_OR_NULL(opp))
+		return PTR_ERR_OR_ZERO(opp);
+
+	if (mode == QCOM_PCIE_D3COLD_FLOOR_BW)
+		ret = icc_set_bw(pcie->icc_floor, 0, dev_pm_opp_get_bw(opp, true, 0));
+	else
+		ret = dev_pm_domain_set_performance_state(dev,
+							  dev_pm_opp_get_required_pstate(opp, 0));
+	dev_pm_opp_put(opp);
+
+	return ret;
+}
+
 static int qcom_pcie_suspend_noirq(struct device *dev)
 {
 	struct qcom_pcie *pcie;
@@ -2219,8 +2306,11 @@
 		if (ret)
 			dev_err(dev, "Failed to disable CPU-PCIe interconnect path: %d\n", ret);
 
-		if (pcie->use_pm_opp)
-			dev_pm_opp_set_opp(pcie->pci->dev, NULL);
+		if (pcie->use_pm_opp) {
+			ret = qcom_pcie_set_d3cold_floor(pcie);
+			if (ret)
+				dev_err(dev, "Failed to set D3cold floor: %d\n", ret);
+		}
 	} else {
 		/*
 		 * Set minimum bandwidth required to keep data path
@@ -2248,8 +2338,12 @@
 				dev_err(dev, "Failed to disable CPU-PCIe interconnect path: %d\n",
 					ret);
 
-			if (pcie->use_pm_opp)
-				dev_pm_opp_set_opp(pcie->pci->dev, NULL);
+			if (pcie->use_pm_opp) {
+				ret = qcom_pcie_set_suspend_opp(pcie);
+				if (ret)
+					dev_err(dev, "Failed to set suspend OPP: %d\n",
+						ret);
+			}
 		}
 	}
 	return ret;
@@ -2266,6 +2360,8 @@
 
 	if (pcie->pci->suspended) {
 		if (pcie->use_pm_opp) {
+			icc_set_bw(pcie->icc_floor, 0, 0);
+
 			ret = qcom_pcie_set_max_opp(dev);
 			if (ret) {
 				dev_err(dev, "Failed to set max OPP: %d\n", ret);
