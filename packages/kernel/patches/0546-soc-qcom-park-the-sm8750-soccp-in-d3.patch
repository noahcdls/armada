From: Armada <noreply@armada.local>
Subject: [PATCH] soc: qcom: park the SM8750 SoCCP in D3

The bootloader leaves the SM8750 SoC Control Processor in D0 (TCSR
0x1fda000 reads 0x2) and mainline has no driver for it, so it keeps
running with no DDR vote held on its behalf. The vendor kernel keeps it
in D3 and, when it wakes it, votes 1200 kBps of DDR first. When the last
other DDR vote drops in s2idle, DDR can collapse under a running SoCCP.

Request D3 at probe over the SoCCP SMP2P "sleep" bit and confirm it in
TCSR, retrying for ten seconds in case the SoCCP services SMP2P late.
The D state is exposed in sysfs ("state") for suspend testing:
"sleep", "wake" (vote DDR first, like the vendor driver), and
"wake-novote" (the state mainline leaves it in).

The protocol follows the vendor rproc_set_state() in qcom_q6v5_pas.c:
bits 9 (sleep) and 10 (wakeup) of the master-kernel entry, with the
SoCCP reporting D0 0x2, D1 0x4 or D3 0x8 in TCSR.
---
diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 2caadbbcf..243c50485 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -236,6 +236,16 @@ config QCOM_SPM
 	  to manage cores, L2 low power modes and to configure the internal
 	  Adaptive Voltage Scaler parameters, where supported.
 
+config QCOM_SOCCP_DSTATE
+	tristate "Qualcomm SM8750 SoCCP D3 parking"
+	depends on ARCH_QCOM || COMPILE_TEST
+	depends on QCOM_SMP2P && INTERCONNECT
+	help
+	  Requests D3 (dormant) from the SM8750 SoC Control Processor over
+	  SMP2P. The bootloader leaves it running with no DDR vote held for
+	  it, which the vendor kernel never does. Exposes the D state in
+	  sysfs for suspend testing.
+
 config QCOM_STATS
 	tristate "Qualcomm Technologies, Inc. (QTI) Sleep stats driver"
 	depends on (ARCH_QCOM && DEBUG_FS) || COMPILE_TEST
diff --git a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
index b7f1d2a57..1cbd404d0 100644
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -31,6 +31,7 @@ obj-$(CONFIG_QCOM_SMSM)	+= smsm.o
 obj-$(CONFIG_QCOM_SOCINFO)	+= socinfo.o
 obj-$(CONFIG_QCOM_SPM)		+= spm.o
 obj-$(CONFIG_QCOM_STATS)	+= qcom_stats.o
+obj-$(CONFIG_QCOM_SOCCP_DSTATE)	+= qcom_soccp_dstate.o
 obj-$(CONFIG_QCOM_WCNSS_CTRL) += wcnss_ctrl.o
 obj-$(CONFIG_QCOM_APR) += apr.o
 obj-$(CONFIG_QCOM_LLCC) += llcc-qcom.o
diff --git a/drivers/soc/qcom/qcom_soccp_dstate.c b/drivers/soc/qcom/qcom_soccp_dstate.c
new file mode 100644
index 000000000..74b234a36
--- /dev/null
+++ b/drivers/soc/qcom/qcom_soccp_dstate.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Park the SM8750 SoCCP in D3 (dormant).
+ *
+ * The bootloader leaves the SoC Control Processor running (D0), and mainline
+ * has no driver for it, so it stays in D0 with no DDR vote held on its
+ * behalf. The vendor kernel keeps it in D3 and wakes it on demand, voting
+ * DDR while it is in D0. This driver requests D3 at probe over the SoCCP
+ * SMP2P "sleep" bit and exposes the D state in sysfs for testing.
+ *
+ * The protocol follows the vendor rproc_set_state(): bits 9 (sleep) and 10
+ * (wakeup) of the master-kernel SMP2P entry request a transition, and the
+ * SoCCP reports its state in a TCSR register (D0 0x2, D1 0x4, D3 0x8).
+ */
+
+#include <linux/bits.h>
+#include <linux/interconnect.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/soc/qcom/smem_state.h>
+#include <linux/sysfs.h>
+#include <linux/workqueue.h>
+
+#define SOCCP_STATE_MASK	(BIT(9) | BIT(10))
+#define SOCCP_D0		BIT(1)
+#define SOCCP_D1		BIT(2)
+#define SOCCP_D3		BIT(3)
+
+#define SOCCP_POLL_US		200
+#define SOCCP_TIMEOUT_US	100000
+#define SOCCP_RETRIES		10
+
+/* Vendor rproc-ddr-lowsvs-icc-bw for the SoCCP, in kBps */
+#define SOCCP_DDR_KBPS		1200
+
+struct soccp_dstate {
+	struct device *dev;
+	void __iomem *tcsr;
+	struct qcom_smem_state *sleep_state;
+	struct qcom_smem_state *wake_state;
+	unsigned int sleep_bit;
+	unsigned int wake_bit;
+	struct icc_path *ddr;
+	struct delayed_work park_work;
+	struct mutex lock;
+	unsigned int attempts;
+};
+
+static const char *soccp_state_name(u32 val)
+{
+	if (val & SOCCP_D3)
+		return "D3";
+	if (val & SOCCP_D1)
+		return "D1";
+	if (val & SOCCP_D0)
+		return "D0";
+	return "unknown";
+}
+
+static int soccp_wait(struct soccp_dstate *sd, u32 mask, u32 *val)
+{
+	return readl_poll_timeout(sd->tcsr, *val, *val & mask,
+				  SOCCP_POLL_US, SOCCP_TIMEOUT_US);
+}
+
+/* D0 -> D3; the DDR vote is dropped only once the SoCCP reports D3 */
+static int soccp_sleep(struct soccp_dstate *sd)
+{
+	u32 val = readl(sd->tcsr);
+	int ret;
+
+	if (val & SOCCP_D3)
+		return 0;
+
+	ret = qcom_smem_state_update_bits(sd->sleep_state, SOCCP_STATE_MASK,
+					  BIT(sd->sleep_bit));
+	if (ret)
+		return ret;
+
+	ret = soccp_wait(sd, SOCCP_D3, &val);
+	if (ret) {
+		qcom_smem_state_update_bits(sd->sleep_state, SOCCP_STATE_MASK, 0);
+		dev_err(sd->dev, "D3 request timed out, tcsr=%#x\n", val);
+		return ret;
+	}
+
+	icc_set_bw(sd->ddr, 0, 0);
+	return 0;
+}
+
+/* D3 -> D0; vote DDR first like the vendor driver unless @vote is false */
+static int soccp_wake(struct soccp_dstate *sd, bool vote)
+{
+	u32 val;
+	int ret;
+
+	if (vote) {
+		ret = icc_set_bw(sd->ddr, kBps_to_icc(SOCCP_DDR_KBPS),
+				 kBps_to_icc(SOCCP_DDR_KBPS));
+		if (ret)
+			return ret;
+	}
+
+	ret = qcom_smem_state_update_bits(sd->wake_state, SOCCP_STATE_MASK,
+					  BIT(sd->wake_bit));
+	if (ret)
+		return ret;
+
+	ret = soccp_wait(sd, SOCCP_D0 | SOCCP_D1, &val);
+	if (ret) {
+		qcom_smem_state_update_bits(sd->wake_state, SOCCP_STATE_MASK, 0);
+		dev_err(sd->dev, "D0 request timed out, tcsr=%#x\n", val);
+	}
+
+	return ret;
+}
+
+/* The SoCCP may not service SMP2P right away, so retry the boot-time park */
+static void soccp_park_work(struct work_struct *work)
+{
+	struct soccp_dstate *sd = container_of(to_delayed_work(work),
+					       struct soccp_dstate, park_work);
+	int ret;
+
+	mutex_lock(&sd->lock);
+	ret = soccp_sleep(sd);
+	mutex_unlock(&sd->lock);
+
+	if (!ret) {
+		dev_info(sd->dev, "parked in D3 (attempt %u)\n", sd->attempts + 1);
+		return;
+	}
+
+	if (++sd->attempts < SOCCP_RETRIES)
+		schedule_delayed_work(&sd->park_work, HZ);
+	else
+		dev_err(sd->dev, "giving up on D3, left in %s\n",
+			soccp_state_name(readl(sd->tcsr)));
+}
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct soccp_dstate *sd = dev_get_drvdata(dev);
+	u32 val = readl(sd->tcsr);
+
+	return sysfs_emit(buf, "%s tcsr=%#x\n", soccp_state_name(val), val);
+}
+
+/*
+ * "sleep": request D3. "wake": vote DDR, then request D0 (vendor behaviour).
+ * "wake-novote": request D0 without a DDR vote, reproducing the state the
+ * bootloader leaves the SoCCP in on mainline.
+ */
+static ssize_t state_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct soccp_dstate *sd = dev_get_drvdata(dev);
+	int ret;
+
+	cancel_delayed_work_sync(&sd->park_work);
+
+	mutex_lock(&sd->lock);
+	if (sysfs_streq(buf, "sleep"))
+		ret = soccp_sleep(sd);
+	else if (sysfs_streq(buf, "wake"))
+		ret = soccp_wake(sd, true);
+	else if (sysfs_streq(buf, "wake-novote"))
+		ret = soccp_wake(sd, false);
+	else
+		ret = -EINVAL;
+	mutex_unlock(&sd->lock);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(state);
+
+static struct attribute *soccp_dstate_attrs[] = {
+	&dev_attr_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(soccp_dstate);
+
+static int soccp_dstate_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct soccp_dstate *sd;
+	struct resource *res;
+
+	sd = devm_kzalloc(dev, sizeof(*sd), GFP_KERNEL);
+	if (!sd)
+		return -ENOMEM;
+
+	sd->dev = dev;
+	mutex_init(&sd->lock);
+	INIT_DELAYED_WORK(&sd->park_work, soccp_park_work);
+
+	/* The register sits in the shared TCSR block; map it without claiming it */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	sd->tcsr = devm_ioremap(dev, res->start, resource_size(res));
+	if (!sd->tcsr)
+		return -ENOMEM;
+
+	sd->sleep_state = devm_qcom_smem_state_get(dev, "sleep", &sd->sleep_bit);
+	if (IS_ERR(sd->sleep_state))
+		return dev_err_probe(dev, PTR_ERR(sd->sleep_state),
+				     "failed to get sleep state\n");
+
+	sd->wake_state = devm_qcom_smem_state_get(dev, "wakeup", &sd->wake_bit);
+	if (IS_ERR(sd->wake_state))
+		return dev_err_probe(dev, PTR_ERR(sd->wake_state),
+				     "failed to get wakeup state\n");
+
+	sd->ddr = devm_of_icc_get(dev, NULL);
+	if (IS_ERR(sd->ddr))
+		return dev_err_probe(dev, PTR_ERR(sd->ddr),
+				     "failed to get DDR path\n");
+
+	platform_set_drvdata(pdev, sd);
+
+	dev_info(dev, "found in %s (tcsr=%#x)\n",
+		 soccp_state_name(readl(sd->tcsr)), readl(sd->tcsr));
+	schedule_delayed_work(&sd->park_work, 0);
+
+	return 0;
+}
+
+static void soccp_dstate_remove(struct platform_device *pdev)
+{
+	struct soccp_dstate *sd = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&sd->park_work);
+}
+
+/* Log the state each suspend so a hang can be matched against it */
+static int soccp_dstate_suspend(struct device *dev)
+{
+	struct soccp_dstate *sd = dev_get_drvdata(dev);
+	u32 val = readl(sd->tcsr);
+
+	dev_info(dev, "%s at suspend (tcsr=%#x)\n", soccp_state_name(val), val);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(soccp_dstate_pm_ops, soccp_dstate_suspend, NULL);
+
+static const struct of_device_id soccp_dstate_of_match[] = {
+	{ .compatible = "armada,sm8750-soccp-dstate" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, soccp_dstate_of_match);
+
+static struct platform_driver soccp_dstate_driver = {
+	.probe = soccp_dstate_probe,
+	.remove = soccp_dstate_remove,
+	.driver = {
+		.name = "qcom-soccp-dstate",
+		.of_match_table = soccp_dstate_of_match,
+		.dev_groups = soccp_dstate_groups,
+		.pm = pm_sleep_ptr(&soccp_dstate_pm_ops),
+	},
+};
+module_platform_driver(soccp_dstate_driver);
+
+MODULE_DESCRIPTION("Park the SM8750 SoCCP in D3");
+MODULE_LICENSE("GPL");
