From: Armada <noreply@armada.local>
Subject: [PATCH] interconnect: qcom: bcm-voter: debug knob to ignore the built-in sleep keepalive

Add icc_bcm_voter.sleep_keepalive_off so the keepalive_sleep flag set by a
platform (SM8750 SN4, 0545) can be switched off at runtime, to re-check
whether a kernel change makes it unnecessary. Off by default.

---
diff --git a/drivers/interconnect/qcom/bcm-voter.c b/drivers/interconnect/qcom/bcm-voter.c
index 2bf4324c2..cc784f93e 100644
--- a/drivers/interconnect/qcom/bcm-voter.c
+++ b/drivers/interconnect/qcom/bcm-voter.c
@@ -69,6 +69,16 @@ module_param_string(sleep_keepalive_bcms, sleep_keepalive_bcms,
 MODULE_PARM_DESC(sleep_keepalive_bcms,
 		 "BCMs that keep a minimal sleep-set vote (debug, default: none)");
 
+/*
+ * Debug knob: ignore the built-in per-BCM sleep keepalive (keepalive_sleep),
+ * to check whether a platform still needs it. Off by default. A change
+ * applies at the next commit of each BCM.
+ */
+static bool sleep_keepalive_off;
+module_param(sleep_keepalive_off, bool, 0644);
+MODULE_PARM_DESC(sleep_keepalive_off,
+		 "Ignore the built-in sleep-set keepalive (debug, default: false)");
+
 static bool bcm_sleep_keepalive(const struct qcom_icc_bcm *bcm)
 {
 	const char *s = sleep_keepalive_bcms;
@@ -153,7 +163,8 @@ static void bcm_aggregate(struct qcom_icc_bcm *bcm)
 
 	if (bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] == 0 &&
 	    bcm->vote_y[QCOM_ICC_BUCKET_SLEEP] == 0 &&
-	    (bcm->keepalive_sleep || bcm_sleep_keepalive(bcm))) {
+	    ((bcm->keepalive_sleep && !sleep_keepalive_off) ||
+	     bcm_sleep_keepalive(bcm))) {
 		bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] = 1;
 		bcm->vote_y[QCOM_ICC_BUCKET_SLEEP] = 1;
 	}
