From: Armada <noreply@armada.local>
Subject: [PATCH] soc: qcom: rpmh-rsc: debug file for raw requests

Add /sys/kernel/debug/<rsc>_raw. Writing "<a|s|w> <addr> <data>" sends one
request in the active, sleep or wake state through the normal rpmh_write()
path. It is for finding what keeps the SM8750 out of AOSS deep sleep:
votes the bootloader left on resources that no Linux driver owns (unused
XO clock buffers, rails, bus clocks) can be cleared or changed one at a
time, with addresses taken from /sys/kernel/debug/cmd-db.

Also add /sys/kernel/debug/qcom_pas_shutdown: writing a PAS id calls
qcom_scm_pas_shutdown() for it, to test whether a subsystem the bootloader
started and Linux never manages (the SPSS, PAS 14) blocks AOSS sleep.

Also add /sys/kernel/debug/rsc_suspend_snapshot (SM8750 only): at the
last-CPU PRE_OFF of an s2idle cycle, snapshot the GCC GDSC status
registers and the SoCCP TCSR D-state, to catch a domain the kernel thinks
is off but the hardware keeps on (as the PCIe GDSCs were with 0044).

Also add /sys/kernel/debug/el1_timers: per-CPU CNTP/CNTV control and
compare values (writing "disarm" clears CNTP_CTL on every CPU), captured
at the PRE_OFF too once a manual read succeeded, to check for an EL1
physical timer the boot chain left armed.

"r <addr>" reads the APPS DRV's current setting back with rpmh_read() and
logs it, to inventory votes left by the bootloader.

Test only. A wrong request can take the board down.
---
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -8,6 +8,8 @@
 
 #include <linux/atomic.h>
 #include <linux/cpu_pm.h>
+#include <linux/debugfs.h>
+#include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/delay.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -25,10 +27,14 @@
 #include <linux/pm_runtime.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
+#include <linux/suspend.h>
+#include <linux/uaccess.h>
 #include <linux/wait.h>
 
+#include <asm/sysreg.h>
 #include <clocksource/arm_arch_timer.h>
 #include <soc/qcom/cmd-db.h>
+#include <soc/qcom/rpmh.h>
 #include <soc/qcom/suspend-trail.h>
 #include <soc/qcom/tcs.h>
 #include <dt-bindings/soc/qcom,rpmh-rsc.h>
@@ -941,6 +947,176 @@
  * * NOTIFY_OK          - success
  * * NOTIFY_BAD         - failure
  */
+/*
+ * Debug only (SM8750): hardware power status at the last-CPU PRE_OFF of an
+ * s2idle cycle, to catch domains the kernel believes are off but the hardware
+ * keeps on (a retention-only GDSC, or one another voter still holds). Only
+ * GCC and TCSR registers, which are readable whenever the CPUs run.
+ */
+static const struct {
+	const char *name;
+	phys_addr_t pa;
+} rsc_snap_regs[] = {
+	{ "gcc_pcie_0_gdsc",          0x0016b004 },
+	{ "gcc_pcie_0_gdsc_cfg",      0x0016b008 },
+	{ "gcc_pcie_0_phy_gdsc",      0x0016c000 },
+	{ "gcc_pcie_0_phy_gdsc_cfg",  0x0016c004 },
+	{ "gcc_ufs_mem_phy_gdsc",     0x0019e000 },
+	{ "gcc_ufs_mem_phy_gdsc_cfg", 0x0019e004 },
+	{ "gcc_ufs_phy_gdsc",         0x00177004 },
+	{ "gcc_ufs_phy_gdsc_cfg",     0x00177008 },
+	{ "gcc_usb30_prim_gdsc",      0x00139004 },
+	{ "gcc_usb30_prim_gdsc_cfg",  0x00139008 },
+	{ "gcc_usb3_phy_gdsc",        0x00150018 },
+	{ "gcc_usb3_phy_gdsc_cfg",    0x0015001c },
+	{ "soccp_tcsr_dstate",        0x01fda000 },
+};
+
+static void __iomem *rsc_snap_base[ARRAY_SIZE(rsc_snap_regs)];
+static u32 rsc_snap_val[ARRAY_SIZE(rsc_snap_regs)];
+static unsigned int rsc_snap_count;
+static bool rsc_snap_ready;
+
+/*
+ * Debug only: EL1 physical and virtual timer state per CPU. Linux at EL1 here
+ * ticks on CNTV; CNTP is unused, so a deadline the boot chain left armed in it
+ * would never be cleared, and the firmware may derive the APSS wake deadline
+ * from it. The PRE_OFF capture only runs after a manual read succeeded.
+ */
+struct rsc_tmr {
+	u64 pctl, pcval, vctl, vcval, pcnt, vcnt;
+};
+
+static DEFINE_PER_CPU(struct rsc_tmr, rsc_tmr_now);
+static struct rsc_tmr rsc_tmr_snap;
+static int rsc_tmr_snap_cpu = -1;
+static bool rsc_tmr_safe;
+
+static void rsc_tmr_read(struct rsc_tmr *t)
+{
+	t->pctl = read_sysreg(cntp_ctl_el0);
+	t->pcval = read_sysreg(cntp_cval_el0);
+	t->vctl = read_sysreg(cntv_ctl_el0);
+	t->vcval = read_sysreg(cntv_cval_el0);
+	t->pcnt = read_sysreg(cntpct_el0);
+	t->vcnt = read_sysreg(cntvct_el0);
+}
+
+static void rsc_tmr_read_cpu(void *unused)
+{
+	rsc_tmr_read(this_cpu_ptr(&rsc_tmr_now));
+}
+
+static void rsc_tmr_disarm_cpu(void *unused)
+{
+	write_sysreg(0, cntp_ctl_el0);
+	isb();
+}
+
+static void rsc_tmr_print(struct seq_file *m, int cpu, struct rsc_tmr *t)
+{
+	seq_printf(m, "%4d  %8llx %+14lld  %8llx %+14lld\n", cpu,
+		   t->pctl, div_s64((s64)(t->pcval - t->pcnt), 19200),
+		   t->vctl, div_s64((s64)(t->vcval - t->vcnt), 19200));
+}
+
+static int rpmh_rsc_tmr_show(struct seq_file *m, void *unused)
+{
+	int cpu;
+
+	on_each_cpu(rsc_tmr_read_cpu, NULL, 1);
+	rsc_tmr_safe = true;
+
+	seq_puts(m, " cpu  CNTP_CTL  CVAL-now (ms)  CNTV_CTL  CVAL-now (ms)   CTL: bit0 enable, bit1 mask, bit2 pending\n");
+	for_each_online_cpu(cpu)
+		rsc_tmr_print(m, cpu, per_cpu_ptr(&rsc_tmr_now, cpu));
+	if (rsc_tmr_snap_cpu >= 0) {
+		seq_puts(m, "last s2idle PRE_OFF (last CPU):\n");
+		rsc_tmr_print(m, rsc_tmr_snap_cpu, &rsc_tmr_snap);
+	}
+
+	return 0;
+}
+
+static int rpmh_rsc_tmr_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, rpmh_rsc_tmr_show, NULL);
+}
+
+static ssize_t rpmh_rsc_tmr_write(struct file *file, const char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	char buf[16] = {};
+
+	if (copy_from_user(buf, ubuf, min(count, sizeof(buf) - 1)))
+		return -EFAULT;
+	if (!sysfs_streq(buf, "disarm"))
+		return -EINVAL;
+
+	on_each_cpu(rsc_tmr_disarm_cpu, NULL, 1);
+	pr_info("rpmh-rsc: CNTP disarmed on all CPUs\n");
+
+	return count;
+}
+
+static const struct file_operations rpmh_rsc_tmr_fops = {
+	.open = rpmh_rsc_tmr_open,
+	.read = seq_read,
+	.write = rpmh_rsc_tmr_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static void rpmh_rsc_snap(void)
+{
+	int i;
+
+	if (!rsc_snap_ready || pm_suspend_target_state != PM_SUSPEND_TO_IDLE)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(rsc_snap_regs); i++)
+		rsc_snap_val[i] = readl_relaxed(rsc_snap_base[i]);
+	if (rsc_tmr_safe) {
+		rsc_tmr_read(&rsc_tmr_snap);
+		rsc_tmr_snap_cpu = smp_processor_id();
+	}
+	rsc_snap_count++;
+}
+
+static int rpmh_rsc_snap_show(struct seq_file *m, void *unused)
+{
+	int i;
+
+	seq_printf(m, "s2idle PRE_OFF snapshots: %u (GDSCR bit 31 = power on)\n",
+		   rsc_snap_count);
+	for (i = 0; i < ARRAY_SIZE(rsc_snap_regs); i++)
+		seq_printf(m, "%-26s %#010x  %08x%s\n", rsc_snap_regs[i].name,
+			   (u32)rsc_snap_regs[i].pa, rsc_snap_val[i],
+			   strstr(rsc_snap_regs[i].name, "gdsc") &&
+			   !strstr(rsc_snap_regs[i].name, "_cfg") &&
+			   (rsc_snap_val[i] & BIT(31)) ? "  ON" : "");
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(rpmh_rsc_snap);
+
+static void rpmh_rsc_snap_init(void)
+{
+	int i;
+
+	if (rsc_snap_ready || !of_machine_is_compatible("qcom,sm8750"))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(rsc_snap_regs); i++) {
+		rsc_snap_base[i] = ioremap(rsc_snap_regs[i].pa, 4);
+		if (!rsc_snap_base[i])
+			return;
+	}
+	rsc_snap_ready = true;
+	debugfs_create_file("rsc_suspend_snapshot", 0400, NULL, NULL, &rpmh_rsc_snap_fops);
+	debugfs_create_file("el1_timers", 0600, NULL, NULL, &rpmh_rsc_tmr_fops);
+}
+
 static int rpmh_rsc_pd_callback(struct notifier_block *nfb,
 				unsigned long action, void *v)
 {
@@ -951,6 +1127,8 @@
 	if (action == GENPD_NOTIFY_PRE_OFF)
 		ret = rpmh_rsc_ctrlr_is_busy(drv) ? -EAGAIN :
 		      rpmh_flush(&drv->client);
+	if (action == GENPD_NOTIFY_PRE_OFF && !ret)
+		rpmh_rsc_snap();
 
 	qcom_suspend_trail_late(QST_EV_RSC_PD, drv->id, action, ret);
 	if (ret)
@@ -1056,6 +1234,109 @@
 	return 0;
 }
 
+/*
+ * Debug only: "<a|s|w> <addr> <data>" sends one raw request in the active,
+ * sleep or wake state, for clearing or testing votes that no driver owns;
+ * "r <addr>" reads this DRV's current setting back (rpmh_read()).
+ * An active request waits for its completion; sleep and wake requests are
+ * cached and written at the next flush.
+ */
+static ssize_t rpmh_rsc_raw_write(struct file *file, const char __user *ubuf,
+				  size_t count, loff_t *ppos)
+{
+	struct rsc_drv *drv = file->private_data;
+	struct tcs_cmd cmd = {};
+	enum rpmh_state state;
+	struct device *child;
+	u32 addr, data;
+	char buf[40], st;
+	int ret, n;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	n = sscanf(buf, "%c %x %x", &st, &addr, &data);
+	if (n < 2 || (n < 3 && st != 'r'))
+		return -EINVAL;
+
+	if (st == 'r') {
+		/* Read back this DRV's current setting for one resource */
+		child = device_find_any_child(drv->dev);
+		if (!child)
+			return -ENODEV;
+		cmd.addr = addr;
+		ret = rpmh_read(child, &cmd);
+		put_device(child);
+		pr_info("rpmh-rsc: read %#x = %#x (%d)\n", addr, cmd.data, ret);
+		return ret ? ret : count;
+	}
+
+	switch (st) {
+	case 'a':
+		state = RPMH_ACTIVE_ONLY_STATE;
+		break;
+	case 's':
+		state = RPMH_SLEEP_STATE;
+		break;
+	case 'w':
+		state = RPMH_WAKE_ONLY_STATE;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* rpmh_write() finds the controller through a child of the RSC */
+	child = device_find_any_child(drv->dev);
+	if (!child)
+		return -ENODEV;
+
+	cmd.addr = addr;
+	cmd.data = data;
+	cmd.wait = state == RPMH_ACTIVE_ONLY_STATE;
+	ret = rpmh_write(child, state, &cmd, 1);
+	put_device(child);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations rpmh_rsc_raw_fops = {
+	.open = simple_open,
+	.write = rpmh_rsc_raw_write,
+	.llseek = default_llseek,
+};
+
+/*
+ * Debug only: writing a PAS id asks TrustZone to shut that peripheral down,
+ * for testing whether a subsystem the bootloader started and no Linux driver
+ * manages (e.g. the SPSS, PAS 14) keeps the SoC out of AOSS deep sleep.
+ */
+static ssize_t rpmh_rsc_pas_shutdown_write(struct file *file, const char __user *ubuf,
+					   size_t count, loff_t *ppos)
+{
+	u32 pas_id;
+	int ret;
+
+	ret = kstrtou32_from_user(ubuf, count, 0, &pas_id);
+	if (ret)
+		return ret;
+
+	ret = qcom_scm_pas_shutdown(pas_id);
+	pr_info("rpmh-rsc: PAS %u shutdown returned %d\n", pas_id, ret);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations rpmh_rsc_pas_shutdown_fops = {
+	.open = simple_open,
+	.write = rpmh_rsc_pas_shutdown_write,
+	.llseek = default_llseek,
+};
+
+static struct dentry *pas_shutdown_file;
+
 static int rpmh_rsc_probe(struct platform_device *pdev)
 {
 	struct device_node *dn = pdev->dev.of_node;
@@ -1158,6 +1439,13 @@
 	dev_set_drvdata(&pdev->dev, drv);
 	drv->dev = &pdev->dev;
 
+	debugfs_create_file(devm_kasprintf(&pdev->dev, GFP_KERNEL, "%s_raw", drv->name) ?: "rsc_raw",
+			    0200, NULL, drv, &rpmh_rsc_raw_fops);
+	rpmh_rsc_snap_init();
+	if (!pas_shutdown_file)
+		pas_shutdown_file = debugfs_create_file("qcom_pas_shutdown", 0200, NULL, NULL,
+							&rpmh_rsc_pas_shutdown_fops);
+
 	return devm_of_platform_populate(&pdev->dev);
 }
 
