From: Armada <noreply@armada.local>
Subject: [PATCH] interconnect: qcom: bcm-voter: switch keepalive_sleep at runtime

Add a sleep_keepalive parameter so the SM8750 MC0 sleep-set keepalive
(0549) can be turned off at runtime, to test the SMP2P sleep state
notifier without it. Test only.
---
diff --git a/drivers/interconnect/qcom/bcm-voter.c b/drivers/interconnect/qcom/bcm-voter.c
index b50042c43..f5e5de5e4 100644
--- a/drivers/interconnect/qcom/bcm-voter.c
+++ b/drivers/interconnect/qcom/bcm-voter.c
@@ -58,6 +58,11 @@ static u64 bcm_div(u64 num, u32 base)
 	return num;
 }
 
+/* Runtime switch for A/B suspend testing of keepalive_sleep BCMs */
+static bool sleep_keepalive = true;
+module_param(sleep_keepalive, bool, 0644);
+MODULE_PARM_DESC(sleep_keepalive, "Keep a minimal sleep-set vote on keepalive_sleep BCMs");
+
 /* BCMs with enable_mask use one-hot-encoding for on/off signaling */
 static void bcm_aggregate_mask(struct qcom_icc_bcm *bcm)
 {
@@ -123,7 +128,8 @@ static void bcm_aggregate(struct qcom_icc_bcm *bcm)
 		bcm->vote_y[QCOM_ICC_BUCKET_WAKE] = 1;
 	}
 
-	if (bcm->keepalive_sleep && bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] == 0 &&
+	if (bcm->keepalive_sleep && sleep_keepalive &&
+	    bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] == 0 &&
 	    bcm->vote_y[QCOM_ICC_BUCKET_SLEEP] == 0) {
 		bcm->vote_x[QCOM_ICC_BUCKET_SLEEP] = 1;
 		bcm->vote_y[QCOM_ICC_BUCKET_SLEEP] = 1;
