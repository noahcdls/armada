From: Armada <noreply@armada.local>
Subject: [PATCH] pmdomain: qcom: rpmhpd: add sleep-set floors for CX, MX and MXC

Add cx_sleep_floor, mx_sleep_floor and mxc_sleep_floor module parameters
holding a minimum sleep-set corner (index into the domain's level table)
on those rails, applied on top of the aggregate and re-voted as soon as
they are written. Test only: checks whether the AYN Odin 3 s2idle APPS
wake hang with every MC0 sleep vote at 0 needs MX (or MXC) held above
retention. Drop before merging.
---
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -976,6 +976,65 @@ static void to_active_sleep(struct rpmhp
  * We send ACTIVE_ONLY votes for resources without any peers. For others,
  * which have an active only peer, all 3 votes are sent.
  */
+/*
+ * s2idle testing: minimum sleep-set corner (index into the domain's level
+ * table) for the CX, MX and MXC rails, applied on top of the aggregate.
+ */
+static unsigned int cx_sleep_floor, mx_sleep_floor, mxc_sleep_floor;
+
+static unsigned int rpmhpd_sleep_floor(struct rpmhpd *pd)
+{
+	unsigned int floor = 0;
+
+	if (pd == &cx || pd == &cx_ao)
+		floor = READ_ONCE(cx_sleep_floor);
+	else if (pd == &mx || pd == &mx_ao)
+		floor = READ_ONCE(mx_sleep_floor);
+	else if (pd == &mxc || pd == &mxc_ao)
+		floor = READ_ONCE(mxc_sleep_floor);
+
+	if (floor && pd->level_count)
+		floor = min_t(unsigned int, floor, pd->level_count - 1);
+
+	return floor;
+}
+
+static int rpmhpd_aggregate_corner(struct rpmhpd *pd, unsigned int corner);
+
+static int rpmhpd_sleep_floor_set(const char *val, const struct kernel_param *kp)
+{
+	struct rpmhpd *pds[] = { &cx, &mx, &mxc };
+	int ret = param_set_uint(val, kp);
+	unsigned int i, floor;
+
+	if (ret)
+		return ret;
+
+	mutex_lock(&rpmhpd_lock);
+	for (i = 0; i < ARRAY_SIZE(pds); i++) {
+		struct rpmhpd *pd = pds[i];
+
+		if (!pd->dev || !pd->level_count)
+			continue;
+
+		floor = rpmhpd_sleep_floor(pd);
+		dev_info(pd->dev, "%s sleep floor corner %u (level %u)\n",
+			 pd->res_name, floor, pd->level[floor]);
+		rpmhpd_aggregate_corner(pd, pd->enabled ? pd->corner : 0);
+	}
+	mutex_unlock(&rpmhpd_lock);
+
+	return 0;
+}
+
+static const struct kernel_param_ops rpmhpd_sleep_floor_ops = {
+	.set = rpmhpd_sleep_floor_set,
+	.get = param_get_uint,
+};
+module_param_cb(cx_sleep_floor, &rpmhpd_sleep_floor_ops, &cx_sleep_floor, 0644);
+module_param_cb(mx_sleep_floor, &rpmhpd_sleep_floor_ops, &mx_sleep_floor, 0644);
+module_param_cb(mxc_sleep_floor, &rpmhpd_sleep_floor_ops, &mxc_sleep_floor, 0644);
+
 static int rpmhpd_aggregate_corner(struct rpmhpd *pd, unsigned int corner)
 {
 	int ret;
@@ -1021,6 +1080,7 @@ static int rpmhpd_aggregate_corner(struc
 			return ret;
 
 		sleep_corner = max(this_sleep_corner, peer_sleep_corner);
+		sleep_corner = max(sleep_corner, rpmhpd_sleep_floor(pd));
 
 		return rpmhpd_send_corner(pd, RPMH_SLEEP_STATE, sleep_corner,
 					  false);
