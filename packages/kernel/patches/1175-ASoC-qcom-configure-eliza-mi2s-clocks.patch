From: Armada contributors <noreply@armada-os.org>
Subject: [PATCH] ASoC: qcom: sc8280xp: configure Eliza MI2S clocks

Take the Eliza MI2S clock and codec setup from RetroidPocket/linux
592a27a5a0376a80db2271c6e97c4f7643b279d8, which sets these flags in the
Eliza private data on Linux 7.3's priv-data driven hw_params.

The Pocket Duo drives two speaker amplifiers from one DAI link, so also
apply the codec format and sysclk to every codec on the link rather than
only the first. Only Eliza, Hawi and Maili set these flags, so no other
card changes behaviour.

---
diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 6c70242f3583..bd4678a584d7 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -305,12 +305,12 @@ static int sc8280xp_snd_hw_params(struct snd_pcm_substream *substream,
 				  struct snd_pcm_hw_params *params)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
-	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 	int mclk_freq = sc8280xp_get_mclk_freq(params);
 	int bclk_freq = sc8280xp_get_bclk_freq(params);
-	int ret;
+	struct snd_soc_dai *codec_dai;
+	int i, ret;
 
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX ... QUATERNARY_MI2S_TX:
@@ -322,10 +322,12 @@ static int sc8280xp_snd_hw_params(struct snd_pcm_substream *substream,
 			return ret;
 
 		if (data->priv->codec_dai_fmt) {
-			ret = snd_soc_dai_set_fmt(codec_dai,
-						  data->priv->codec_dai_fmt);
-			if (ret && ret != -ENOTSUPP)
-				return ret;
+			for_each_rtd_codec_dais(rtd, i, codec_dai) {
+				ret = snd_soc_dai_set_fmt(codec_dai,
+							  data->priv->codec_dai_fmt);
+				if (ret && ret != -ENOTSUPP)
+					return ret;
+			}
 		}
 
 		if (data->priv->mi2s_mclk_enable) {
@@ -345,11 +347,13 @@ static int sc8280xp_snd_hw_params(struct snd_pcm_substream *substream,
 		}
 
 		if (data->priv->codec_sysclk_set) {
-			ret = snd_soc_dai_set_sysclk(codec_dai,
-						     0, mclk_freq,
-						     SND_SOC_CLOCK_IN);
-			if (ret && ret != -ENOTSUPP)
-				return ret;
+			for_each_rtd_codec_dais(rtd, i, codec_dai) {
+				ret = snd_soc_dai_set_sysclk(codec_dai,
+							     0, mclk_freq,
+							     SND_SOC_CLOCK_IN);
+				if (ret && ret != -ENOTSUPP)
+					return ret;
+			}
 		}
 		break;
 	case PRIMARY_TDM_RX_0 ... QUINARY_TDM_TX_7:
@@ -555,6 +559,12 @@ static const struct qcom_snd_soc_common eliza_priv_data = {
 	.dapm_widgets = sc8280xp_dapm_widgets,
 	.num_dapm_widgets = ARRAY_SIZE(sc8280xp_dapm_widgets),
 	.wcd_jack = true,
+	.mi2s_mclk_enable = true,
+	.mi2s_bclk_enable = true,
+	.codec_sysclk_set = true,
+	.codec_dai_fmt = SND_SOC_DAIFMT_BC_FC |
+			 SND_SOC_DAIFMT_NB_NF |
+			 SND_SOC_DAIFMT_I2S,
 };
 
 static const struct qcom_snd_soc_common hawi_priv_data = {
