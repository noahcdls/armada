From: Armada <noreply@armada.local>
Subject: [PATCH] soc: qcom: add an SMP2P sleepstate driver

Port the Qualcomm vendor smp2p_sleepstate driver: it tells a remote
processor over SMP2P whether the application processor is awake by
clearing the "awake" bit at PM_SUSPEND_PREPARE and setting it again at
PM_POST_SUSPEND. The SM8750 vendor kernel does this for the ADSP, which
otherwise always sees the AP as awake. The bit comes from
qcom,smem-states rather than being hardcoded; the vendor's inbound
sensor-wakeup interrupt is not carried over. qcom_smp2p_sleepstate.notify
(runtime writable, default on) disables the suspend report for testing.
---
diff --git a/drivers/soc/qcom/qcom-smp2p-sleepstate.c b/drivers/soc/qcom/qcom-smp2p-sleepstate.c
new file mode 100644
index 000000000..8ee69bd86
--- /dev/null
+++ b/drivers/soc/qcom/qcom-smp2p-sleepstate.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Tell a remote processor over SMP2P whether the application processor is
+ * awake, as the Qualcomm vendor kernel does for the ADSP: the "awake" bit is
+ * cleared when system suspend starts and set again once it has finished.
+ */
+
+#include <linux/bits.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/soc/qcom/smem_state.h>
+#include <linux/suspend.h>
+
+static bool notify = true;
+module_param(notify, bool, 0644);
+MODULE_PARM_DESC(notify, "Report system suspend to the remote processor");
+
+struct smp2p_sleepstate {
+	struct qcom_smem_state *state;
+	unsigned int awake_bit;
+	struct notifier_block pm_nb;
+};
+
+static int smp2p_sleepstate_pm_notifier(struct notifier_block *nb,
+					unsigned long event, void *unused)
+{
+	struct smp2p_sleepstate *s = container_of(nb, struct smp2p_sleepstate, pm_nb);
+	u32 mask = BIT(s->awake_bit);
+
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+		if (READ_ONCE(notify))
+			qcom_smem_state_update_bits(s->state, mask, 0);
+		break;
+	case PM_POST_SUSPEND:
+		qcom_smem_state_update_bits(s->state, mask, mask);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static void smp2p_sleepstate_unregister(void *data)
+{
+	struct smp2p_sleepstate *s = data;
+
+	unregister_pm_notifier(&s->pm_nb);
+}
+
+static int smp2p_sleepstate_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct smp2p_sleepstate *s;
+	int ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	s->state = devm_qcom_smem_state_get(dev, "awake", &s->awake_bit);
+	if (IS_ERR(s->state))
+		return dev_err_probe(dev, PTR_ERR(s->state), "failed to get awake state\n");
+
+	ret = qcom_smem_state_update_bits(s->state, BIT(s->awake_bit), BIT(s->awake_bit));
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to report awake\n");
+
+	/* Run before other notifiers, as the vendor driver does */
+	s->pm_nb.notifier_call = smp2p_sleepstate_pm_notifier;
+	s->pm_nb.priority = INT_MAX;
+	ret = register_pm_notifier(&s->pm_nb);
+	if (ret)
+		return ret;
+
+	return devm_add_action_or_reset(dev, smp2p_sleepstate_unregister, s);
+}
+
+static const struct of_device_id smp2p_sleepstate_of_match[] = {
+	{ .compatible = "qcom,smp2p-sleepstate" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, smp2p_sleepstate_of_match);
+
+static struct platform_driver smp2p_sleepstate_driver = {
+	.probe = smp2p_sleepstate_probe,
+	.driver = {
+		.name = "qcom-smp2p-sleepstate",
+		.of_match_table = smp2p_sleepstate_of_match,
+	},
+};
+module_platform_driver(smp2p_sleepstate_driver);
+
+MODULE_DESCRIPTION("Qualcomm SMP2P application processor sleep state");
+MODULE_LICENSE("GPL");
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -209,6 +209,13 @@
 	  Say yes here to support the Qualcomm Shared Memory Point to Point
 	  protocol.
 
+config QCOM_SMP2P_SLEEPSTATE
+	tristate "Qualcomm SMP2P application processor sleep state"
+	depends on QCOM_SMP2P
+	help
+	  Report system suspend to a remote processor over SMP2P, as the
+	  Qualcomm vendor kernel does for the ADSP.
+
 config QCOM_SMSM
 	tristate "Qualcomm Shared Memory State Machine"
 	depends on MAILBOX
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -27,6 +27,7 @@
 obj-$(CONFIG_QCOM_SMEM_STATE) += smem_state.o
 CFLAGS_smp2p.o := -I$(src)
 obj-$(CONFIG_QCOM_SMP2P)	+= smp2p.o
+obj-$(CONFIG_QCOM_SMP2P_SLEEPSTATE)	+= qcom-smp2p-sleepstate.o
 obj-$(CONFIG_QCOM_SMSM)	+= smsm.o
 obj-$(CONFIG_QCOM_SOCINFO)	+= socinfo.o
 obj-$(CONFIG_QCOM_SPM)		+= spm.o
