From: Armada <noreply@armada.local>
Subject: [PATCH] drm/msm/dsi/phy: unprepare the AHB clock on runtime suspend

The DSI PHY manages its "iface" (MDSS AHB) clock through pm_clk.
pm_clk prepares a clock once when it is added and only disables and
enables it across runtime PM, unless the clock itself is "enabled when
prepared". disp_cc_mdss_ahb_clk has enable ops, so it stays prepared for
as long as the PHY is bound. That keeps its parent bi_tcxo prepared, and
clk-rpmh votes XO (including the sleep set) on prepare, so XO can never
shut down and the SoC never reaches CXSD in s2idle.

Tracing clk_prepare/clk_unprepare and rpmh_send_msg across s2idle on the
AYN Odin 3 (SM8750) showed disp_cc_mdss_ahb_clk as the last prepared
XO-sourced clock at the RPMh sleep flush.

Handle the clock explicitly instead: clk_prepare_enable() on runtime
resume and clk_disable_unprepare() on runtime suspend. The clock core
still runtime-resumes the PHY before preparing its PLL clocks, so the
AHB/PLL ordering pm_clk was introduced for is kept.
---
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
index 1fb3899b8..efda6a537 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -3,9 +3,9 @@
  * Copyright (c) 2015, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
 #include <dt-bindings/phy/phy.h>
 
@@ -683,18 +683,15 @@ static int dsi_phy_driver_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, phy);
 
-	ret = devm_pm_runtime_enable(dev);
-	if (ret)
-		return ret;
+	phy->ahb_clk = devm_clk_get(dev, "iface");
+	if (IS_ERR(phy->ahb_clk))
+		return dev_err_probe(dev, PTR_ERR(phy->ahb_clk),
+				     "Unable to get iface clk\n");
 
-	ret = devm_pm_clk_create(dev);
+	ret = devm_pm_runtime_enable(dev);
 	if (ret)
 		return ret;
 
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
-
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
 		if (ret)
@@ -711,8 +708,28 @@ static int dsi_phy_driver_probe(struct platform_device *pdev)
 	return 0;
 }
 
+/*
+ * Fully unprepare the AHB clock on runtime suspend: pm_clk keeps it prepared,
+ * which holds the RPMh XO vote in the sleep set and blocks XO shutdown.
+ */
+static int dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	clk_disable_unprepare(phy->ahb_clk);
+
+	return 0;
+}
+
+static int dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(phy->ahb_clk);
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	SET_RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
index f5d3e806f..e658dd283 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -107,6 +107,7 @@ struct msm_dsi_phy {
 	int id;
 
 	struct regulator_bulk_data *supplies;
+	struct clk *ahb_clk;
 
 	struct msm_dsi_dphy_timing timing;
 	const struct msm_dsi_phy_cfg *cfg;
