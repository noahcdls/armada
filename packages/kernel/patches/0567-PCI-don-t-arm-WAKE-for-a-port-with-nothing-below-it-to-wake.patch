From: Armada <noreply@armada.local>
Subject: [PATCH] PCI: don't arm WAKE# for a port with nothing below it allowed to wake

pci_configure_wake_irq() makes a port with an OF WAKE# GPIO a wakeup
source, so the PM core arms the line for every system sleep. When no
device below the port may wake the system, WAKE# can only fire
spuriously. On SM8750 (AYN Odin 3), pcie-qcom powers the WCN7860 off
through pwrctrl in suspend_noirq once its link is in D3cold; with the
PMU rails also released the unpowered chip pulls WAKE# low, the
level-low wake IRQ fires and the sleep is aborted before CX collapse.

Drop the port's wakeup in ->prepare() for that sleep when nothing
subordinate may wake, and restore it in ->complete() (or when the
driver's ->prepare() fails). A wake-enabled endpoint keeps WAKE# armed,
and dw_pcie_suspend_noirq() then keeps its power on as before.
---
--- a/drivers/pci/pci-driver.c
+++ b/drivers/pci/pci-driver.c
@@ -759,17 +759,62 @@
 
 /* New power management framework */
 
+static int pci_dev_may_wake(struct pci_dev *dev, void *data)
+{
+	if (!device_may_wakeup(&dev->dev))
+		return 0;
+
+	*(bool *)data = true;
+	return 1;
+}
+
+/*
+ * A WAKE# GPIO makes its port a wakeup source, so the PM core arms the line
+ * for every system sleep.  Unless a device below the port may wake the
+ * system, WAKE# can only fire spuriously: a host controller that powers the
+ * endpoint off through pwrctrl leaves it unpowered, and its I/O pulls WAKE#
+ * low, which aborts the sleep.  Drop the port's wakeup for this sleep only.
+ */
+static void pci_pm_suspend_wake_gpio(struct pci_dev *pci_dev)
+{
+	bool may_wake = false;
+
+	if (!pci_dev->wake || !pci_dev->subordinate ||
+	    !device_may_wakeup(&pci_dev->dev))
+		return;
+
+	pci_walk_bus(pci_dev->subordinate, pci_dev_may_wake, &may_wake);
+	if (may_wake)
+		return;
+
+	device_set_wakeup_enable(&pci_dev->dev, false);
+	pci_dev->wake_suspended = true;
+}
+
+static void pci_pm_restore_wake_gpio(struct pci_dev *pci_dev)
+{
+	if (!pci_dev->wake_suspended)
+		return;
+
+	device_set_wakeup_enable(&pci_dev->dev, true);
+	pci_dev->wake_suspended = false;
+}
+
 static int pci_pm_prepare(struct device *dev)
 {
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 	const struct dev_pm_ops *pm = dev->driver ? dev->driver->pm : NULL;
 
 	dev_pm_set_strict_midlayer(dev, true);
+	pci_pm_suspend_wake_gpio(pci_dev);
 
 	if (pm && pm->prepare) {
 		int error = pm->prepare(dev);
-		if (error < 0)
+		if (error < 0) {
+			/* No ->complete() follows a failed ->prepare() */
+			pci_pm_restore_wake_gpio(pci_dev);
 			return error;
+		}
 
 		if (!error && dev_pm_test_driver_flags(dev, DPM_FLAG_SMART_PREPARE))
 			return 0;
@@ -789,6 +834,7 @@
 {
 	struct pci_dev *pci_dev = to_pci_dev(dev);
 
+	pci_pm_restore_wake_gpio(pci_dev);
 	pci_dev_complete_resume(pci_dev);
 	pm_generic_complete(dev);
 
--- a/include/linux/pci.h
+++ b/include/linux/pci.h
@@ -592,6 +592,7 @@
 	u8 reset_methods[PCI_NUM_RESET_METHODS]; /* In priority order */
 
 	struct gpio_desc *wake;		/* WAKE# GPIO */
+	bool		wake_suspended;	/* WAKE# wakeup dropped for this sleep */
 
 #ifdef CONFIG_PCIE_TPH
 	u16		tph_cap;	/* TPH capability offset */
